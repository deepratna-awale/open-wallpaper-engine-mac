    "Browse, search and subscribe to Workshop items without leaving the app, then set them as your wallpaper in one click." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsuchen und abonnieren Sie Workshop-Objekte, ohne die App zu verlassen, und legen Sie sie mit einem Klick als Hintergrundbild fest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourez, recherchez et abonnez-vous aux éléments du Workshop sans quitter l’app, puis définissez-les comme fond d’écran en un clic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explora, busca y suscríbete a elementos del Workshop sin salir de la app, y ponlos como fondo de pantalla con un solo clic."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore, busque e inscreva-se em itens da Oficina sem sair do app e defina-os como imagem de fundo com um clique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfoglia, cerca e sottoscrivi gli elementi del Workshop senza uscire dall’app, poi impostali come sfondo con un clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを離れることなくワークショップのアイテムをブラウズ、検索、サブスクライブして、ワンクリックで壁紙に設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 벗어나지 않고 창작마당 항목을 탐색, 검색 및 구독한 다음 클릭 한 번으로 배경화면으로 설정할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需离开 App 即可浏览、搜索和订阅创意工坊项目，然后一键设为墙纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無需離開 App 即可瀏覽、搜尋和訂閱工作坊項目，按一下就能設為背景圖片。"
          }
        }
      }
    },
