    "Arrow keys work when this panel is focused. Shift moves faster, Control moves slower." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل مفاتيح الأسهم عند التركيز على هذه اللوحة. يحرّك Shift بشكل أسرع، ويحرّك Control بشكل أبطأ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pfeiltasten funktionieren, wenn dieser Bereich aktiv ist. Mit Shift bewegen Sie schneller, mit Control langsamer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las teclas de flecha funcionan cuando este panel está activo. Con Mayúsculas se mueve más rápido; con Control, más despacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les touches fléchées fonctionnent lorsque ce panneau est actif. Maj accélère le déplacement, Contrôle le ralentit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पैनल फ़ोकस में होने पर ऐरो कुंजियाँ काम करती हैं. Shift से तेज़ और Control से धीमे मूव होता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tasti freccia funzionano quando questo pannello è attivo. Shift sposta più velocemente, Control più lentamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパネルにフォーカスがあるときは矢印キーを使用できます。shiftで速く、controlでゆっくり移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 패널에 초점이 있을 때 화살표 키로 이동할 수 있습니다. Shift를 누르면 더 빠르게, Control을 누르면 더 느리게 이동합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klawisze strzałek działają, gdy ten panel jest aktywny. Z klawiszem Shift ruch jest szybszy, z Control — wolniejszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As teclas de seta funcionam quando este painel está em foco. Shift move mais rápido, Control move mais devagar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клавиши со стрелками работают, когда эта панель активна. С Shift — быстрее, с Control — медленнее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu panel etkinken ok tuşları çalışır. Shift daha hızlı, Control daha yavaş taşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клавіші зі стрілками працюють, коли ця панель активна. Shift пересуває швидше, Control — повільніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此面板获得焦点时可使用方向键。按住 Shift 移动更快，按住 Control 移动更慢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此面板為焦點時可使用方向鍵。按住 Shift 移動較快，按住 Control 移動較慢。"
          }
        }
      }
    },
