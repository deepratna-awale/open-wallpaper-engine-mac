    "The app contacts only Valve (Steam and SteamCMD) and GitHub (app updates). Web wallpapers may load their own online content." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتصل التطبيق إلا بـ Valve (‏Steam وSteamCMD) وGitHub (تحديثات التطبيق). قد تحمّل خلفيات الويب محتواها الخاص عبر الإنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App kontaktiert nur Valve (Steam und SteamCMD) und GitHub (App-Updates). Web-Hintergrundbilder können eigene Online-Inhalte laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app solo contacta con Valve (Steam y SteamCMD) y GitHub (actualizaciones de la app). Los fondos de pantalla web pueden cargar su propio contenido en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app ne contacte que Valve (Steam et SteamCMD) et GitHub (mises à jour de l’app). Les fonds d’écran Web peuvent charger leur propre contenu en ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप केवल Valve (Steam और SteamCMD) और GitHub (ऐप अपडेट) से संपर्क करता है। वेब वॉलपेपर अपनी ऑनलाइन सामग्री लोड कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app contatta solo Valve (Steam e SteamCMD) e GitHub (aggiornamenti dell’app). Gli sfondi web possono caricare contenuti online propri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが通信するのはValve（SteamとSteamCMD）とGitHub（アプリのアップデート）だけです。Web壁紙は独自のオンラインコンテンツを読み込む場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 Valve(Steam 및 SteamCMD)와 GitHub(앱 업데이트)에만 연결합니다. 웹 배경화면은 자체 온라인 콘텐츠를 불러올 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja łączy się tylko z Valve (Steam i SteamCMD) oraz GitHubem (uaktualnienia aplikacji). Tapety internetowe mogą wczytywać własne treści online."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app só se conecta à Valve (Steam e SteamCMD) e ao GitHub (atualizações do app). Imagens de fundo da web podem carregar seu próprio conteúdo online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение связывается только с Valve (Steam и SteamCMD) и GitHub (обновления приложения). Веб-обои могут загружать собственный онлайн-контент."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama yalnızca Valve (Steam ve SteamCMD) ve GitHub (uygulama güncellemeleri) ile iletişim kurar. Web duvar kâğıtları kendi çevrimiçi içeriklerini yükleyebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма звертається лише до Valve (Steam і SteamCMD) та GitHub (оновлення програми). Вебшпалери можуть завантажувати власний онлайн-вміст."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 仅联系 Valve（Steam 和 SteamCMD）和 GitHub（App 更新）。网页墙纸可能会加载自己的在线内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 僅會連線至 Valve（Steam 和 SteamCMD）及 GitHub（App 更新項目）。網頁背景圖片可能會載入自己的線上內容。"
          }
        }
      }
    },
    "The download continues in the background." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستمر التنزيل في الخلفية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Download läuft im Hintergrund weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga continúa en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléchargement continue en arrière-plan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड बैकग्राउंड में जारी रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il download continua in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードはバックグラウンドで続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드는 백그라운드에서 계속됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobieranie będzie kontynuowane w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O download continua em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузка продолжится в фоне."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirme arka planda sürer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Викачування триватиме у фоні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载会在后台继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載會在背景繼續。"
          }
        }
      }
    },
    "The same shortcuts are shown in the menus. You can change them in System Settings › Keyboard › Keyboard Shortcuts › App Shortcuts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الاختصارات نفسها في القوائم. يمكنك تغييرها في إعدادات النظام › لوحة المفاتيح › اختصارات لوحة المفاتيح › اختصارات التطبيقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieselben Kurzbefehle stehen in den Menüs. Sie können sie unter „Systemeinstellungen“ › „Tastatur“ › „Tastaturkurzbefehle“ › „App-Kurzbefehle“ ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las mismas funciones rápidas aparecen en los menús. Puedes cambiarlas en Ajustes del Sistema › Teclado › Funciones rápidas de teclado › Funciones rápidas de apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mêmes raccourcis figurent dans les menus. Vous pouvez les modifier dans Réglages Système › Clavier › Raccourcis clavier › Raccourcis des apps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यही शॉर्टकट मेनू में दिखते हैं। आप इन्हें सिस्टम सेटिंग › कीबोर्ड › कीबोर्ड शॉर्टकट › ऐप शॉर्टकट में बदल सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stesse abbreviazioni sono indicate nei menu. Puoi modificarle in Impostazioni di Sistema › Tastiera › Abbreviazioni da tastiera › Abbreviazioni app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じショートカットがメニューに表示されます。「システム設定」›「キーボード」›「キーボードショートカット」›「アプリのショートカット」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 단축키가 메뉴에 표시됩니다. 시스템 설정 › 키보드 › 키보드 단축키 › 앱 단축키에서 변경할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te same skróty są widoczne w menu. Możesz je zmienić w Ustawieniach systemowych › Klawiatura › Skróty klawiszowe › Skróty aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os mesmos atalhos aparecem nos menus. Você pode alterá-los em Ajustes do Sistema › Teclado › Atalhos de Teclado › Atalhos de Apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те же сочетания показаны в меню. Их можно изменить в «Системных настройках» › «Клавиатура» › «Сочетания клавиш» › «Сочетания клавиш для приложений»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı kestirmeler menülerde gösterilir. Bunları Sistem Ayarları › Klavye › Klavye Kestirmeleri › Uygulama Kestirmeleri’nde değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ті самі скорочення показано в меню. Їх можна змінити в «Системних параметрах» › «Клавіатура» › «Клавіатурні скорочення» › «Скорочення для програм»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单中也显示相同的快捷键。你可以在“系统设置” › “键盘” › “键盘快捷键” › “App 快捷键”中更改它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選單中也會顯示相同的快速鍵。你可以在「系統設定」›「鍵盤」›「鍵盤快速鍵」›「App 快速鍵」中更改。"
          }
        }
      }
    },
    "The SteamCMD download from Valve isn't a valid archive. Try again later." : {
      "comment" : "Error installing SteamCMD: the downloaded file is not a valid archive",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف SteamCMD الذي تم تنزيله من Valve ليس أرشيفًا صالحًا. حاول مرة أخرى لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der SteamCMD-Download von Valve ist kein gültiges Archiv. Versuchen Sie es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga de SteamCMD de Valve no es un archivo comprimido válido. Vuelve a intentarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléchargement de SteamCMD depuis Valve n’est pas une archive valide. Réessayez plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valve से डाउनलोड किया गया SteamCMD मान्य आर्काइव नहीं है. बाद में फिर से कोशिश करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il download di SteamCMD da Valve non è un archivio valido. Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valve からダウンロードした SteamCMD は有効なアーカイブではありません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valve에서 다운로드한 SteamCMD가 유효한 압축 파일이 아닙니다. 나중에 다시 시도하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobrany od Valve SteamCMD nie jest prawidłowym archiwum. Spróbuj ponownie później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O download do SteamCMD da Valve não é um arquivo compactado válido. Tente novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загруженный с сервера Valve SteamCMD не является допустимым архивом. Повторите попытку позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valve’dan indirilen SteamCMD geçerli bir arşiv değil. Daha sonra yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажений від Valve SteamCMD не є дійсним архівом. Спробуйте пізніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 Valve 下载的 SteamCMD 不是有效的归档。请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從 Valve 下載的 SteamCMD 不是有效的封存檔。請稍後再試一次。"
          }
        }
      }
    },
    "The SteamCMD package from Valve has no runnable steamcmd.sh." : {
      "comment" : "Error installing SteamCMD: the downloaded package lacks an executable steamcmd.sh",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحتوي حزمة SteamCMD من Valve على ملف steamcmd.sh قابل للتشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das SteamCMD-Paket von Valve enthält kein ausführbares steamcmd.sh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paquete de SteamCMD de Valve no contiene un steamcmd.sh ejecutable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paquet SteamCMD de Valve ne contient pas de steamcmd.sh exécutable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valve के SteamCMD पैकेज में चलाने योग्य steamcmd.sh नहीं है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pacchetto SteamCMD di Valve non contiene un steamcmd.sh eseguibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valve の SteamCMD パッケージに実行可能な steamcmd.sh がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valve의 SteamCMD 패키지에 실행 가능한 steamcmd.sh가 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakiet SteamCMD od Valve nie zawiera wykonywalnego pliku steamcmd.sh."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
