        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O quanto a camada desliza em sentido oposto ao ponteiro. Dê mais às camadas de fundo do que às de primeiro plano para reforçar a profundidade."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto scorre il livello in direzione opposta al puntatore. Dai più movimento ai livelli di sfondo rispetto a quelli in primo piano per rendere credibile la profondità."
          }
        }
      }
    },
    "How far the leaves bend." : {
