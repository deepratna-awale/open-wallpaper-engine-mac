    "Audio capture starts on its own once the permission is granted; no restart is needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ التقاط الصوت تلقائيًا بمجرد منح الإذن؛ ولا حاجة إلى إعادة التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Audioaufnahme startet automatisch, sobald die Berechtigung erteilt wurde. Ein Neustart ist nicht erforderlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La captura de audio empezará sola en cuanto se conceda el permiso; no hace falta reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capture audio démarre d’elle-même une fois l’autorisation accordée ; aucun redémarrage n’est nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति मिलते ही ऑडियो कैप्चर अपने आप शुरू हो जाता है; रीस्टार्ट करने की ज़रूरत नहीं है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’acquisizione audio si avvia da sola non appena concedi l’autorizzazione; non serve riavviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可されるとオーディオのキャプチャが自動的に開始されます。再起動は必要ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한이 허용되면 오디오 캡처가 자동으로 시작되며, 재시동할 필요가 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechwytywanie dźwięku rozpocznie się samo po udzieleniu pozwolenia; ponowne uruchomienie nie jest potrzebne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A captura de áudio começa sozinha assim que a permissão é concedida; não é preciso reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захват звука начнётся сам после выдачи разрешения; перезапуск не нужен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin verildiğinde ses yakalama kendiliğinden başlar; yeniden başlatmanız gerekmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записування звуку почнеться автоматично, щойно дозвіл буде надано; перезапуск не потрібен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授予权限后，音频捕获会自动开始，无需重新启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授與權限後即會自動開始擷取音訊，無需重新啟動。"
          }
        }
      }
    },
