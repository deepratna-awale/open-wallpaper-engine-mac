        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Горизонтальна швидкість. Відʼємні значення рухають у протилежний бік, 0 зупиняє."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水平速度。负值向相反方向移动，0 为停止。"
