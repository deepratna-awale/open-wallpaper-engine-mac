    "Offsets the start of the animation, useful for de-syncing two copies of an effect." : {
      "comment" : "Scene Inspector tooltip for an effect parameter named like phase",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيح بداية الحركة، وهو مفيد لإلغاء تزامن نسختين من التأثير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versetzt den Start der Animation – nützlich, um zwei Kopien eines Effekts zu desynchronisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza el inicio de la animación; útil para desincronizar dos copias de un efecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décale le début de l’animation, utile pour désynchroniser deux copies d’un effet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐनिमेशन की शुरुआत को आगे-पीछे करता है; किसी इफ़ेक्ट की दो कॉपी को अलग-अलग ताल पर चलाने के लिए उपयोगी."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta l’inizio dell’animazione, utile per desincronizzare due copie di un effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アニメーションの開始をずらします。エフェクトの2つのコピーの同期をずらすのに便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "애니메이션의 시작 시점을 오프셋합니다. 같은 효과의 두 복사본을 서로 어긋나게 할 때 유용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwa początek animacji; przydaje się do rozsynchronizowania dwóch kopii efektu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desloca o início da animação; útil para dessincronizar duas cópias de um efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смещает начало анимации — полезно, чтобы рассинхронизировать две копии эффекта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animasyonun başlangıcını kaydırır; bir efektin iki kopyasını birbirinden ayrı zamanlamak için kullanışlıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зсуває початок анімації; корисно, щоб розсинхронізувати дві копії ефекту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偏移动画的起始时间，可用于使同一效果的两个副本错开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偏移動畫的起點，可用來讓同一效果的兩個副本不同步。"
          }
        }
      }
    },
    "Offsets, scales or rotates the layer." : {
      "comment" : "Scene Inspector tooltip for the transform effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيح الطبقة أو يغيّر حجمها أو يدوّرها."
          }
        },
        "de" : {
