    "Showing wallpapers with any checked genre. Click to show only wallpapers with all of them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم عرض الخلفيات التي تحمل أيًّا من الأنواع المحددة. انقر لعرض الخلفيات التي تحملها جميعًا فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrundbilder mit einem der markierten Genres werden angezeigt. Klicken Sie, um nur Hintergrundbilder mit allen Genres anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestran fondos de pantalla con cualquiera de los géneros marcados. Haz clic para mostrar solo los que tengan todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichage des fonds d’écran ayant au moins un des genres cochés. Cliquez pour n’afficher que ceux qui les ont tous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनी गई किसी भी शैली वाले वॉलपेपर दिखाए जा रहे हैं. केवल सभी शैलियों वाले वॉलपेपर दिखाने के लिए क्लिक करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra gli sfondi con almeno uno dei generi selezionati. Fai clic per mostrare solo gli sfondi che li hanno tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックしたいずれかのジャンルを含む壁紙を表示しています。クリックすると、すべてのジャンルを含む壁紙のみを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 장르 중 하나라도 포함된 배경화면을 표시하는 중입니다. 모든 장르가 포함된 배경화면만 표시하려면 클릭하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlane są tapety z dowolnym z zaznaczonych gatunków. Kliknij, aby pokazać tylko tapety ze wszystkimi z nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando imagens de fundo com qualquer um dos gêneros marcados. Clique para mostrar apenas as que têm todos eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показаны обои с любым из отмеченных жанров. Нажмите, чтобы показать только обои со всеми жанрами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşaretli türlerden herhangi birine sahip duvar kâğıtları gösteriliyor. Yalnızca tümüne sahip olanları göstermek için tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показуються шпалери з будь-яким із вибраних жанрів. Клацніть, щоб показати лише шпалери з усіма ними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在显示含有任一所选类型的墙纸。点按以仅显示含有全部所选类型的墙纸。"
