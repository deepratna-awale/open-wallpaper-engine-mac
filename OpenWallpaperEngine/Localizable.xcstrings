    "Opacity left behind where the colour is keyed out. 0 makes matched pixels fully transparent." : {
      "comment" : "Scene Inspector tooltip for the colorkey effect's alpha parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbleibende Deckkraft dort, wo die Farbe freigestellt wird. 0 macht passende Pixel vollständig transparent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opacité conservée là où la couleur est détourée. 0 rend les pixels correspondants totalement transparents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opacidad que queda donde se elimina el color. 0 hace que los píxeles coincidentes sean totalmente transparentes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
