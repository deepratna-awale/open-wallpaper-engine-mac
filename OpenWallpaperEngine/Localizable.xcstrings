    "Pause, mute or switch wallpapers from the menu bar at any time. Open Settings to fine-tune the rest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausieren, stummschalten oder wechseln Sie Hintergrundbilder jederzeit über die Menüleiste. In den Einstellungen passen Sie den Rest an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez en pause, coupez le son ou changez de fond d’écran depuis la barre des menus à tout moment. Ouvrez les Réglages pour peaufiner le reste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa, silencia o cambia de fondo de pantalla desde la barra de menús en cualquier momento. Abre Ajustes para ajustar el resto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause, silencie ou troque de imagem de fundo pela barra de menus a qualquer momento. Abra os Ajustes para ajustar o resto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in pausa, disattiva l’audio o cambia sfondo dalla barra dei menu in qualsiasi momento. Apri Impostazioni per regolare il resto."
          }
        }
      }
    },
