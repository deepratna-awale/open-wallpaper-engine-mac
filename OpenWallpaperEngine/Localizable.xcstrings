          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine — бесплатная программа с открытым исходным кодом по лицензии GPL-3.0, предоставляемая «как есть», без гарантий."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine, GPL-3.0 lisansıyla sunulan ücretsiz ve açık kaynaklı bir yazılımdır; olduğu gibi ve garantisiz sağlanır."
          }
        },
        "uk" : {
