          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal dibuja el vídeo a través del renderizador de escenas para que se le apliquen los efectos y la sincronización con la música, como hace Wallpaper Engine. Experimental."
          }
