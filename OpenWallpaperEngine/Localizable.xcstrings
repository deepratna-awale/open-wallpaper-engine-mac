        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL किसी सपोर्ट किए गए इमेज या वीडियो एक्सटेंशन पर खत्म होना चाहिए."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’URL deve terminare con un’estensione di immagine o video supportata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URLの末尾は、サポートされている画像またはビデオの拡張子である必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL은 지원되는 이미지 또는 비디오 확장자로 끝나야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adres URL musi kończyć się obsługiwanym rozszerzeniem obrazu lub wideo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A URL deve terminar com uma extensão de imagem ou vídeo compatível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL должен заканчиваться поддерживаемым расширением изображения или видео."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL, desteklenen bir görüntü veya video uzantısıyla bitmelidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL-адреса має закінчуватися підтримуваним розширенням зображення чи відео."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL 必须以受支持的图像或视频扩展名结尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL 必須以支援的影像或影片副檔名結尾。"
          }
        }
      }
    },
    "The Wallpaper Storage folder %@ is on %@, which isn't connected. Connect it, or choose another folder in Settings → General." : {
      "comment" : "The first %@ is a folder path, the second a disk name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجلد مخزن خلفيات الشاشة %@ موجود على %@، وهو غير متصل. قم بتوصيله، أو اختر مجلدًا آخر في الإعدادات ← عام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner für den Hintergrundbild-Speicher „%@“ befindet sich auf „%@“, das nicht verbunden ist. Verbinden Sie das Volume oder wählen Sie unter „Einstellungen“ > „Allgemein“ einen anderen Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Wallpaper Storage folder %1$@ is on %2$@, which isn't connected. Connect it, or choose another folder in Settings → General."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta de almacenamiento de fondos de pantalla %@ está en %@, que no está conectado. Conéctalo o elige otra carpeta en Ajustes → General."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier de stockage des fonds d’écran %@ se trouve sur %@, qui n’est pas connecté. Connectez-le ou choisissez un autre dossier dans Réglages → Général."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉलपेपर स्टोरेज फ़ोल्डर %1$@, %2$@ पर है, जो कनेक्ट नहीं है. इसे कनेक्ट करें, या सेटिंग → सामान्य में कोई दूसरा फ़ोल्डर चुनें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella Archivio sfondi %@ si trova su %@, che non è collegato. Collegalo o scegli un’altra cartella in Impostazioni → Generali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙の保存場所のフォルダ%@は%@上にありますが、接続されていません。接続するか、「設定」>「一般」で別のフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면 저장 공간 폴더 %@이(가) 연결되지 않은 %@에 있습니다. 해당 디스크를 연결하거나 설정 → 일반에서 다른 폴더를 선택하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder Magazynu tapet %@ znajduje się na dysku „%@”, który nie jest podłączony. Podłącz go lub wybierz inny folder w Ustawieniach → Ogólne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta de Armazenamento de Imagens de Fundo %@ está em %@, que não está conectado. Conecte-o ou escolha outra pasta em Ajustes → Geral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка хранилища обоев %1$@ находится на диске %2$@, который не подключён. Подключите его или выберите другую папку в меню «Настройки» → «Основные»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duvar Kâğıdı Deposu klasörü (%@) bağlı olmayan bir diskte: %@. Diski bağlayın veya Ayarlar → Genel bölümünden başka bir klasör seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка сховища шпалер %@ розташована на диску «%@», який не підʼєднано. Підʼєднайте його або виберіть іншу папку в меню «Параметри» → «Загальні»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "墙纸存储位置文件夹 %@ 位于未连接的“%@”上。请连接该磁盘，或在“设置”→“通用”中选择其他文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景圖片儲存位置檔案夾 %1$@ 位於「%2$@」，但該磁碟未連接。請連接磁碟，或在「設定」→「一般」中選擇其他檔案夾。"
          }
        }
      }
    },
    "The cut-off where the effect starts to apply. Lower catches more of the image, higher restricts it to the strongest pixels." : {
      "comment" : "Scene Inspector tooltip for an effect parameter named like threshold",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحد الذي يبدأ عنده تطبيق التأثير. القيم الأدنى تشمل جزءًا أكبر من الصورة، والأعلى تقصره على أقوى وحدات البكسل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwelle, ab der der Effekt wirkt. Niedrigere Werte erfassen mehr vom Bild, höhere beschränken ihn auf die stärksten Pixel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbral a partir del cual se aplica el efecto. Los valores bajos abarcan más imagen; los altos lo limitan a los píxeles más intensos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuil à partir duquel l’effet s’applique. Une valeur basse inclut davantage de l’image, une valeur haute le limite aux pixels les plus intenses."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह सीमा जहाँ से इफ़ेक्ट लागू होना शुरू होता है. कम मान इमेज का ज़्यादा हिस्सा शामिल करते हैं, ज़्यादा मान इसे सबसे तेज़ पिक्सेल तक सीमित करते हैं."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La soglia da cui l’effetto inizia ad applicarsi. Valori bassi coinvolgono più parti dell’immagine, valori alti lo limitano ai pixel più intensi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エフェクトが適用され始めるしきい値です。低い値では画像のより多くの部分が対象になり、高い値では最も強いピクセルだけに限定されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "효과가 적용되기 시작하는 기준값입니다. 낮을수록 이미지의 더 많은 부분이 포함되고, 높을수록 가장 강한 픽셀로 제한됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próg, od którego efekt zaczyna działać. Niższy obejmuje większą część obrazu, wyższy ogranicza efekt do najsilniejszych pikseli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O limite a partir do qual o efeito começa a ser aplicado. Valores menores abrangem mais da imagem; maiores o restringem aos pixels mais fortes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порог, с которого начинает действовать эффект. Меньшие значения охватывают больше изображения, большие ограничивают его самыми яркими пикселями."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efektin uygulanmaya başladığı eşik. Düşük değerler görüntünün daha fazlasını yakalar, yüksek değerler efekti en güçlü piksellerle sınırlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поріг, з якого ефект починає застосовуватися. Нижчі значення охоплюють більше зображення, вищі обмежують його найсильнішими пікселями."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "效果开始生效的阈值。数值越低覆盖的图像越多，越高则仅限于最强的像素。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "效果開始套用的臨界值。數值越低涵蓋越多影像，越高則僅限於最強的像素。"
          }
        }
      }
    },
    "The most particles one wallpaper may hold. A wallpaper made with more draws every particle system thinner, keeping its look." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحد الأقصى لعدد الجسيمات في خلفية واحدة. الخلفية المصممة بعدد أكبر ترسم كل نظام جسيمات بكثافة أقل، مع الحفاظ على مظهرها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die maximale Anzahl an Partikeln pro Hintergrundbild. Ein Hintergrundbild mit mehr Partikeln zeichnet jedes Partikelsystem dünner und behält so sein Aussehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de partículas que puede tener un fondo de pantalla. Si uno se creó con más, cada sistema de partículas se dibuja con menos densidad, conservando su aspecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre maximal de particules par fond d’écran. Un fond d’écran conçu avec davantage de particules allège chaque système de particules tout en conservant son apparence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक वॉलपेपर में अधिकतम कितने पार्टिकल हो सकते हैं. इससे ज़्यादा पार्टिकल वाला वॉलपेपर हर पार्टिकल सिस्टम को कम घना बनाता है, ताकि उसका लुक बना रहे."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il numero massimo di particelle che uno sfondo può contenere. Uno sfondo creato con più particelle disegna ogni sistema particellare più rado, mantenendone l’aspetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つの壁紙が保持できるパーティクルの最大数です。これより多いパーティクルで作成された壁紙は、見た目を保ったまま各パーティクルシステムをまばらに描画します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면 하나가 가질 수 있는 최대 파티클 수입니다. 이보다 많은 파티클로 제작된 배경화면은 모든 파티클 시스템을 더 성기게 그려 원래 모습을 유지합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksymalna liczba cząsteczek w jednej tapecie. Tapeta utworzona z większą ich liczbą rysuje każdy system cząsteczek rzadziej, zachowując jego wygląd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O máximo de partículas que uma imagem de fundo pode ter. Uma imagem de fundo criada com mais desenha cada sistema de partículas de forma mais esparsa, mantendo sua aparência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное число частиц в одних обоях. Если в обоях их больше, каждая система частиц прорежается, сохраняя внешний вид."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir duvar kâğıdının içerebileceği en fazla parçacık sayısı. Daha fazlasıyla hazırlanmış bir duvar kâğıdı, görünümünü koruyarak her parçacık sistemini daha seyrek çizer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найбільша кількість частинок, яку може містити одна шпалера. Шпалера, створена з більшою кількістю, малює кожну систему частинок розрідженіше, зберігаючи її вигляд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单张墙纸可包含的最大粒子数。超出此数量的墙纸会按比例减少每个粒子系统的粒子，同时保持其外观。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單一背景圖片可容納的粒子數上限。粒子較多的背景圖片會讓每個粒子系統繪製得較稀疏，同時保持原有外觀。"
          }
        }
      }
    },
    "The scripts of “%@” were stopped because one of them ran for too long. The wallpaper keeps showing, without its scripted animations." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إيقاف النصوص البرمجية في «%@» لأن أحدها استغرق وقتًا طويلًا جدًا. تظل الخلفية معروضة، ولكن من دون الحركات التي تنفذها نصوصها البرمجية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Skripte von „%@“ wurden gestoppt, weil eines davon zu lange lief. Das Hintergrundbild wird weiterhin angezeigt, jedoch ohne seine geskripteten Animationen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han detenido los scripts de «%@» porque uno de ellos tardaba demasiado. El fondo de pantalla se sigue mostrando, sin sus animaciones con scripts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les scripts de « %@ » ont été arrêtés, car l’un d’eux s’exécutait depuis trop longtemps. Le fond d’écran reste affiché, sans ses animations scriptées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” की स्क्रिप्ट रोक दी गईं, क्योंकि उनमें से एक बहुत देर तक चली. वॉलपेपर दिखता रहेगा, पर स्क्रिप्ट वाले ऐनिमेशन के बिना."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli script di “%@” sono stati interrotti perché uno di essi è rimasto in esecuzione troppo a lungo. Lo sfondo resta visibile, senza le animazioni basate su script."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」のスクリプトの1つの実行時間が長すぎたため、スクリプトを停止しました。壁紙はスクリプトによるアニメーションなしで表示され続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’의 스크립트 중 하나가 너무 오래 실행되어 스크립트가 중지되었습니다. 배경화면은 스크립트 애니메이션 없이 계속 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrypty tapety „%@” zostały zatrzymane, ponieważ jeden z nich działał zbyt długo. Tapeta jest nadal wyświetlana, ale bez animacji sterowanych skryptami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os scripts de “%@” foram interrompidos porque um deles foi executado por tempo demais. A imagem de fundo continua sendo exibida, sem as animações por script."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрипты обоев «%@» остановлены, так как один из них выполнялся слишком долго. Обои продолжают отображаться, но без скриптовой анимации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” duvar kâğıdının betiklerinden biri çok uzun süre çalıştığı için betikler durduruldu. Duvar kâğıdı, betikli animasyonları olmadan gösterilmeye devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрипти шпалери «%@» зупинено, оскільки один із них виконувався надто довго. Шпалера й далі показується, але без анімацій на основі скриптів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于“%@”的某个脚本运行时间过长，其脚本已被停止。墙纸会继续显示，但不再有脚本动画。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於其中一個腳本執行時間過長，「%@」的腳本已停止。背景圖片會繼續顯示，但不含腳本動畫。"
          }
        }
      }
    },
