    "Saves the current properties and Scene Inspector edits. A preset with the same name is replaced." : {
      "comment" : "Message of the prompt that names a new wallpaper preset",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ الخصائص الحالية وتعديلات مراقب المشهد. يُستبدل الإعداد المسبق الذي يحمل الاسم نفسه."
          }
        },
        "de" : {
