    "How strongly the effect is applied. 0 disables it." : {
      "comment" : "Scene Inspector tooltip for an effect parameter named like amount",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie stark der Effekt angewendet wird. 0 deaktiviert ihn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensité d’application de l’effet. 0 le désactive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensidad con la que se aplica el efecto. 0 lo desactiva."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A intensidade com que o efeito é aplicado. 0 o desativa."
          }
