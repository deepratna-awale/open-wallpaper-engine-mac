    "Shaders are translated from GLSL to Metal by the compiler built into the app, once, and cached." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يترجم المُصرِّف المدمج في التطبيق المظللات من GLSL إلى Metal مرة واحدة، ثم يخزنها مؤقتًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shader werden vom integrierten Compiler der App einmalig von GLSL nach Metal übersetzt und zwischengespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El compilador integrado en la app traduce los sombreadores de GLSL a Metal una sola vez y los guarda en caché."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nuanceurs sont traduits de GLSL vers Metal une seule fois par le compilateur intégré à l’app, puis mis en cache."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शेडर को ऐप में बिल्ट-इन कंपाइलर एक बार GLSL से Metal में ट्रांसलेट करता है, और फिर कैश कर लेता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli shader vengono tradotti da GLSL a Metal dal compilatore integrato nell’app, una sola volta, e memorizzati nella cache."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェーダーは、アプリに内蔵されたコンパイラによってGLSLからMetalに一度だけ変換され、キャッシュされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셰이더는 앱에 내장된 컴파일러를 통해 GLSL에서 Metal로 한 번 변환된 후 캐시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shadery są jednorazowo tłumaczone z GLSL na Metal przez wbudowany w aplikację kompilator i zapisywane w pamięci podręcznej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os shaders são traduzidos de GLSL para Metal pelo compilador integrado ao app, uma única vez, e armazenados em cache."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шейдеры переводятся из GLSL в Metal встроенным в приложение компилятором один раз и кэшируются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gölgelendiriciler, uygulamaya yerleşik derleyici tarafından GLSL’den Metal’e bir kez çevrilir ve önbelleğe alınır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шейдери перекладаються з GLSL у Metal вбудованим у програму компілятором один раз і кешуються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "着色器由 App 内置的编译器从 GLSL 转译为 Metal，仅转译一次并缓存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "著色器會由 App 內建的編譯器從 GLSL 轉譯為 Metal，只需轉譯一次並會加以快取。"
          }
        }
      }
    },
