          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta imagem de fundo estava sendo exibida quando o Open Wallpaper Engine falhou, travou ou foi forçado a encerrar duas vezes seguidas. Isso pode acontecer novamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
