    "A new language takes effect the next time Open Wallpaper Engine opens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neue Sprache wird beim nächsten Öffnen von Open Wallpaper Engine wirksam."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle langue prend effet à la prochaine ouverture d’Open Wallpaper Engine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nuevo idioma se aplicará la próxima vez que abras Open Wallpaper Engine."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um novo idioma entra em vigor na próxima vez que o Open Wallpaper Engine for aberto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuova lingua verrà applicata alla prossima apertura di Open Wallpaper Engine."
          }
        }
      }
    },
    "A placeholder that does nothing. Authors use it to reserve a slot in the effect stack." : {
      "comment" : "Scene Inspector tooltip for the empty effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Platzhalter ohne Funktion. Autoren reservieren damit einen Platz im Effektstapel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un espace réservé sans effet. Les auteurs l’utilisent pour réserver un emplacement dans la pile d’effets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un marcador de posición que no hace nada. Los autores lo usan para reservar un hueco en la pila de efectos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um marcador de posição que não faz nada. Os autores o usam para reservar uma posição na pilha de efeitos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un segnaposto che non fa nulla. Gli autori lo usano per riservare una posizione nella pila degli effetti."
          }
        }
      }
    },
