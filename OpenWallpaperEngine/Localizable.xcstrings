          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta l’inizio dell’animazione, utile per desincronizzare due copie di un effetto."
          }
        }
      }
    },
    "Offsets, scales or rotates the layer." : {
