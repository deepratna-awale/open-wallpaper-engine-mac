    "Audio capture starts on its own once the permission is granted; no restart is needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Audioaufnahme startet automatisch, sobald die Berechtigung erteilt wurde. Ein Neustart ist nicht erforderlich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capture audio démarre d’elle-même une fois l’autorisation accordée ; aucun redémarrage n’est nécessaire."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La captura de audio empezará sola en cuanto se conceda el permiso; no hace falta reiniciar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A captura de áudio começa sozinha assim que a permissão é concedida; não é preciso reiniciar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’acquisizione audio si avvia da sola non appena concedi l’autorizzazione; non serve riavviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可されるとオーディオのキャプチャが自動的に開始されます。再起動は必要ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한이 허용되면 오디오 캡처가 자동으로 시작되며, 재시동할 필요가 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授予权限后，音频捕获会自动开始，无需重新启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授與權限後即會自動開始擷取音訊，無需重新啟動。"
          }
        }
      }
