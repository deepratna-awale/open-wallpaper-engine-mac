        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сила искривления изображения линзой. Отрицательные значения стягивают его внутрь, а не выпячивают."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merceğin görüntüyü ne kadar güçlü büktüğü. Negatif değerler dışa doğru şişirmek yerine içe doğru sıkıştırır."
          }
        },
        "uk" : {
