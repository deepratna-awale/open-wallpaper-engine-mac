    "Loudness of the wallpaper's own soundtrack. Set it to 0 to keep the wallpaper silent." : {
      "comment" : "Details panel tooltip",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautstärke des eigenen Soundtracks des Hintergrundbilds. Setzen Sie sie auf 0, damit das Hintergrundbild stumm bleibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume de la bande-son propre au fond d’écran. Réglez-le sur 0 pour rendre le fond d’écran silencieux."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volumen de la banda sonora del propio fondo de pantalla. Ponlo a 0 para que el fondo de pantalla no tenga sonido."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume da trilha sonora da própria imagem de fundo. Defina como 0 para deixá-la em silêncio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume della colonna sonora dello sfondo. Impostalo su 0 per renderlo silenzioso."
          }
        }
      }
    },
    "Low" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
