    "Paste a link to any video or image. Images are turned into a scene, so the effect stack applies to them as well." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie einen Link zu einem beliebigen Video oder Bild ein. Bilder werden in eine Szene umgewandelt, sodass der Effektstapel auch auf sie angewendet wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez le lien de n’importe quelle vidéo ou image. Les images sont converties en scène, la pile d’effets s’y applique donc aussi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega un enlace a cualquier vídeo o imagen. Las imágenes se convierten en una escena, así que la pila de efectos también se les aplica."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole um link para qualquer vídeo ou imagem. As imagens são transformadas em uma cena, então a pilha de efeitos também se aplica a elas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla un link a qualsiasi video o immagine. Le immagini vengono trasformate in una scena, così anche a loro si applica la pila degli effetti."
          }
        }
      }
    },
