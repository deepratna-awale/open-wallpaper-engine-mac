    "Slides the texture continuously, useful for tiling backgrounds." : {
      "comment" : "Scene Inspector tooltip for the scroll effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُزلق النسيج باستمرار، وهو مفيد للخلفيات المتكررة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt die Textur fortlaufend – nützlich für gekachelte Hintergründe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza la textura de forma continua; útil para fondos en mosaico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait défiler la texture en continu, utile pour les arrière-plans en mosaïque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक्सचर को लगातार खिसकाता है; टाइल होने वाले बैकग्राउंड के लिए उपयोगी."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa scorrere la texture senza sosta, utile per sfondi ripetuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テクスチャを連続的にスライドさせます。タイル状の背景に便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스처를 계속 밀어 이동시키며, 타일링 배경에 유용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stale przesuwa teksturę; przydatne w przypadku kafelkowych teł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a textura continuamente; útil para fundos que se repetem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непрерывно сдвигает текстуру — удобно для повторяющихся фонов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokuyu sürekli olarak kaydırır; döşenen arka planlar için kullanışlıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безперервно зсуває текстуру; корисно для фонів, що повторюються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持续滑动纹理，适用于平铺背景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持續滑動紋理，適用於拼貼背景。"
          }
        }
      }
    },
