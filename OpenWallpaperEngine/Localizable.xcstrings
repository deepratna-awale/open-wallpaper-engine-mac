    "Log in with your Steam account to browse and download wallpapers.\nYou must own Wallpaper Engine on Steam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich mit Ihrem Steam-Account an, um Hintergrundbilder zu durchsuchen und zu laden.\nSie müssen Wallpaper Engine auf Steam besitzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec votre compte Steam pour parcourir et télécharger des fonds d’écran.\nVous devez posséder Wallpaper Engine sur Steam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con tu cuenta de Steam para explorar y descargar fondos de pantalla.\nDebes tener Wallpaper Engine en Steam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão com sua conta Steam para explorar e baixar imagens de fundo.\nVocê precisa ter o Wallpaper Engine no Steam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con il tuo account Steam per sfogliare e scaricare sfondi.\nDevi possedere Wallpaper Engine su Steam."
          }
        }
      }
    },
    "Login failed. Check credentials and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmeldung fehlgeschlagen. Überprüfen Sie Ihre Anmeldedaten und versuchen Sie es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
