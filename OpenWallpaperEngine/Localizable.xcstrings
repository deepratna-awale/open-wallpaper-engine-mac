    "Ultra mode adds HDR bloom to supported wallpapers and is only recommended for powerful high-end desktop graphics cards." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超高模式会为支持的墙纸添加 HDR 泛光，建议仅用于性能强大的高端台式机显卡。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ultra-Modus fügt unterstützten Hintergrundbildern HDR-Bloom hinzu und wird nur für leistungsstarke High-End-Desktop-Grafikkarten empfohlen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Ultra ajoute un flou lumineux HDR aux fonds d’écran compatibles et n’est recommandé que pour les cartes graphiques de bureau haut de gamme et puissantes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Ultra añade resplandor HDR a los fondos de pantalla compatibles y solo se recomienda para tarjetas gráficas de sobremesa potentes y de gama alta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo Ultra adiciona bloom HDR às imagens de fundo compatíveis e só é recomendado para placas de vídeo de desktop potentes e de alto desempenho."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità Ultra aggiunge il bloom HDR agli sfondi supportati ed è consigliata solo per schede grafiche desktop potenti e di fascia alta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウルトラモードは、対応する壁紙にHDRブルームを追加します。高性能なハイエンドのデスクトップ用グラフィックカードでのみ推奨されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "울트라 모드는 지원되는 배경화면에 HDR 블룸을 추가하며, 고성능 하이엔드 데스크탑 그래픽 카드에서만 권장됩니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「超高」模式會為支援的背景圖片加入 HDR 光暈，僅建議用於效能強大的高階桌上型顯示卡。"
          }
        }
      }
    },
