    "Pick the frame rate, anti-aliasing and texture quality that suit your Mac, and check the Diagnostics page to see the impact." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie Bildrate, Antialiasing und Texturqualität passend für Ihren Mac und sehen Sie die Auswirkungen im Bereich „Diagnose“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la fréquence d’images, l’anticrénelage et la qualité des textures adaptés à votre Mac, et consultez la page Diagnostic pour en voir l’impact."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la velocidad de fotogramas, el suavizado de contorno y la calidad de las texturas que mejor le vayan a tu Mac, y consulta la página Diagnóstico para ver el impacto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a taxa de quadros, a suavização e a qualidade de textura adequadas ao seu Mac e consulte a página Diagnóstico para ver o impacto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la frequenza fotogrammi, l’anti-aliasing e la qualità delle texture più adatti al tuo Mac e controlla la pagina Diagnosi per vederne l’impatto."
          }
        }
      }
    },
