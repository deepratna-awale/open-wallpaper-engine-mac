    "Wavelength. Low values give many small ripples, high values give a few broad swells." : {
      "comment" : "Scene Inspector tooltip for the waterwaves effect's scale parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wellenlänge. Niedrige Werte ergeben viele kleine Wellen, hohe Werte wenige breite Wogen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longueur d’onde. Les faibles valeurs donnent de nombreuses petites ondulations, les valeurs élevées quelques larges houles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longitud de onda. Los valores bajos dan muchas ondas pequeñas; los altos, pocos oleajes amplios."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprimento de onda. Valores baixos geram muitas ondulações pequenas; valores altos, poucas ondas largas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunghezza d’onda. Valori bassi danno tante piccole increspature, valori alti poche onde ampie."
          }
        }
      }
    },
