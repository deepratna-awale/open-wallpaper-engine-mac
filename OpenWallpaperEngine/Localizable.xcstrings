        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーンインスペクタでこの壁紙に加えたすべての変更を取り消します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면 인스펙터에서 이 배경화면에 적용한 모든 변경 사항을 취소합니다"
          }
        },
        "pl" : {
