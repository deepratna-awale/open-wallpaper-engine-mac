    "Blurs outward from a centre point, giving a zoom or speed streak look." : {
      "comment" : "Scene Inspector tooltip for the blurradial effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يموّه نحو الخارج انطلاقًا من نقطة مركزية، ليمنح مظهر التكبير أو خطوط السرعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet von einem Mittelpunkt nach außen weich – für einen Zoom- oder Geschwindigkeitseffekt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenfoca hacia fuera desde un punto central, con un efecto de zoom o estela de velocidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floute vers l’extérieur à partir d’un point central, pour un effet de zoom ou de traînées de vitesse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केंद्र बिंदु से बाहर की ओर ब्लर करता है, जिससे ज़ूम या स्पीड स्ट्रीक जैसा लुक मिलता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfoca verso l’esterno da un punto centrale, creando un effetto zoom o scie di velocità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中心点から外側へぼかし、ズームやスピードの流れのような効果を与えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중심점에서 바깥쪽으로 흐리게 하여 줌 또는 속도감 있는 줄무늬 효과를 냅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmywa obraz na zewnątrz od punktu centralnego, dając efekt zbliżenia lub smug prędkości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfoca para fora a partir de um ponto central, criando um visual de zoom ou de rastro de velocidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
