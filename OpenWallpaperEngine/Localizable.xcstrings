    "Open Wallpaper Engine is free, open-source software under the GPL-3.0 licence, provided as is, without warranty." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine برنامج مجاني ومفتوح المصدر بموجب ترخيص GPL-3.0، ويُقدَّم كما هو دون أي ضمان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine ist kostenlose Open-Source-Software unter der Lizenz GPL-3.0 und wird ohne Gewähr bereitgestellt, so wie sie ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine es software gratuito y de código abierto con licencia GPL-3.0, que se ofrece tal cual, sin garantía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine est un logiciel libre et gratuit sous licence GPL-3.0, fourni tel quel, sans garantie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine GPL-3.0 लाइसेंस के तहत मुफ़्त, ओपन-सोर्स सॉफ़्टवेयर है, जो बिना किसी वारंटी के जैसा है वैसा दिया जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine è software gratuito e open source con licenza GPL-3.0, fornito così com’è, senza garanzia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engineは、GPL-3.0ライセンスの無料のオープンソースソフトウェアで、現状のまま無保証で提供されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine은 GPL-3.0 라이선스의 무료 오픈 소스 소프트웨어이며, 보증 없이 있는 그대로 제공됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine to bezpłatne oprogramowanie open source na licencji GPL-3.0, udostępniane w stanie „takim, jakie jest”, bez gwarancji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
