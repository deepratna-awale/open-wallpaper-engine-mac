    "%@ isn't a Steam library with Wallpaper Engine Workshop items. Choose the Steam folder or its steamapps folder." : {
      "comment" : "%@ is a folder name; steamapps is a folder name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ليس مكتبة Steam تحتوي على عناصر ورشة Wallpaper Engine. اختر مجلد Steam أو مجلد steamapps الخاص به."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist keine Steam-Bibliothek mit Workshop-Objekten von Wallpaper Engine. Wählen Sie den Steam-Ordner oder dessen Ordner „steamapps“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es una biblioteca de Steam con elementos del Workshop de Wallpaper Engine. Elige la carpeta de Steam o su carpeta steamapps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas une bibliothèque Steam contenant des éléments du Workshop de Wallpaper Engine. Choisissez le dossier Steam ou son dossier steamapps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Wallpaper Engine के Workshop आइटम वाली Steam लाइब्रेरी नहीं है। Steam फ़ोल्डर या उसका steamapps फ़ोल्डर चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è una libreria Steam con elementi del Workshop di Wallpaper Engine. Scegli la cartella di Steam o la sua cartella steamapps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は、Wallpaper Engine のワークショップアイテムがある Steam ライブラリではありません。Steam フォルダか、その steamapps フォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) Wallpaper Engine 창작마당 항목이 있는 Steam 라이브러리가 아닙니다. Steam 폴더나 그 안의 steamapps 폴더를 선택하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie jest biblioteką Steam z elementami Warsztatu Wallpaper Engine. Wybierz folder Steam lub jego folder steamapps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não é uma biblioteca Steam com itens da Oficina do Wallpaper Engine. Escolha a pasta do Steam ou a pasta steamapps dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не является библиотекой Steam с элементами Мастерской Wallpaper Engine. Выберите папку Steam или её папку steamapps."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, Wallpaper Engine Atölye öğeleri içeren bir Steam kütüphanesi değil. Steam klasörünü ya da içindeki steamapps klasörünü seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не є бібліотекою Steam з елементами Майстерні Wallpaper Engine. Виберіть папку Steam або її папку steamapps."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是包含 Wallpaper Engine 创意工坊项目的 Steam 库。请选择 Steam 文件夹或其中的 steamapps 文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不是包含 Wallpaper Engine 工作坊項目的 Steam 收藏庫。請選擇 Steam 檔案夾或其中的 steamapps 檔案夾。"
          }
        }
      }
    },
    "%@ isn't a Wallpaper Engine folder or its assets folder." : {
      "comment" : "Assets error; %@ is a folder path",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ ليس مجلد Wallpaper Engine ولا مجلد assets الخاص به."
          }
        },
        "de" : {
