        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "픽셀이 광선을 내뿜기 위해 필요한 밝기입니다. 이미지의 더 많은 부분을 포함하려면 낮추고, 하이라이트에만 광선을 유지하려면 높이십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak jasny musi być piksel, aby rzucał promienie. Obniż, aby objąć większą część obrazu, podnieś, aby promienie wychodziły tylko z najjaśniejszych miejsc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
