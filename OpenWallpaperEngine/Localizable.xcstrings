    "WE shaders are translated per combination of options the first time a scene uses them, then reused." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُترجم مظللات WE لكل مجموعة من الخيارات عند أول استخدام لها في مشهد، ثم يُعاد استخدامها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WE-Shader werden für jede Kombination von Optionen übersetzt, wenn eine Szene sie zum ersten Mal verwendet, und dann wiederverwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sombreadores de WE se traducen para cada combinación de opciones la primera vez que una escena los usa, y después se reutilizan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nuanceurs WE sont traduits pour chaque combinaison d’options la première fois qu’une scène les utilise, puis réutilisés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WE शेडर विकल्पों के हर कॉम्बिनेशन के लिए तब ट्रांसलेट होते हैं जब कोई सीन उन्हें पहली बार उपयोग करता है, फिर दोबारा उपयोग किए जाते हैं."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli shader di WE vengono tradotti per ogni combinazione di opzioni la prima volta che una scena li usa, poi vengono riutilizzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WEのシェーダーは、シーンで初めて使用されるときにオプションの組み合わせごとに変換され、その後再利用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WE 셰이더는 장면에서 처음 사용될 때 옵션 조합별로 변환된 후 재사용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shadery WE są tłumaczone dla każdej kombinacji opcji, gdy scena użyje ich po raz pierwszy, a potem używane ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os shaders do WE são traduzidos para cada combinação de opções na primeira vez que uma cena os usa e, depois, reutilizados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шейдеры WE переводятся для каждой комбинации параметров при первом использовании в сцене, а затем используются повторно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WE gölgelendiricileri, bir sahne tarafından ilk kullanıldıklarında her seçenek birleşimi için ayrı ayrı çevrilir ve sonra yeniden kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шейдери WE перекладаються для кожної комбінації параметрів, коли сцена вперше їх використовує, а потім використовуються повторно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WE 着色器会在场景首次使用时按每种选项组合进行转译，之后重复使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WE 著色器會在場景首次使用時，依每種選項組合進行轉譯，之後重複使用。"
          }
        }
      }
    },
