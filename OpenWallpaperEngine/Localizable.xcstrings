    "How far the layer slides against the pointer. Give background layers more than foreground ones to sell the depth." : {
      "comment" : "Scene Inspector tooltip for the parallax effect's amount parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit sich die Ebene gegen den Zeiger verschiebt. Geben Sie Hintergrundebenen mehr als Vordergrundebenen, damit die Tiefe überzeugt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissement du calque à l’opposé du pointeur. Donnez-en davantage aux calques d’arrière-plan qu’à ceux de premier plan pour renforcer l’effet de profondeur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto se desliza la capa en sentido contrario al puntero. Da más a las capas de fondo que a las de primer plano para reforzar la profundidad."
