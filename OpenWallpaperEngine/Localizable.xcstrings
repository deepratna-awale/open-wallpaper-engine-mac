    "Workshop downloads, their dependencies and imported wallpapers go into this folder. You can move the current library to the new location." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workshop-Downloads, ihre Abhängigkeiten und importierte Hintergrundbilder werden in diesem Ordner abgelegt. Sie können die aktuelle Mediathek an den neuen Ort bewegen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les téléchargements du Workshop, leurs dépendances et les fonds d’écran importés sont placés dans ce dossier. Vous pouvez déplacer la bibliothèque actuelle vers le nouvel emplacement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las descargas del Workshop, sus dependencias y los fondos de pantalla importados se guardan en esta carpeta. Puedes trasladar la biblioteca actual a la nueva ubicación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os downloads da Oficina, suas dependências e as imagens de fundo importadas vão para esta pasta. Você pode mover a biblioteca atual para o novo local."
          }
