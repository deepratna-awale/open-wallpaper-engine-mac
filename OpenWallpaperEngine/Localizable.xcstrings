    "Size of the noise pattern. Lower is coarser and blotchier, higher is finer." : {
      "comment" : "Scene Inspector tooltip for an effect parameter named like noise_scale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größe des Rauschmusters. Niedrigere Werte sind gröber und fleckiger, höhere feiner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille du motif de bruit. Plus la valeur est basse, plus il est grossier et tacheté ; plus elle est haute, plus il est fin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño del patrón de ruido. Los valores bajos son más gruesos y con manchas; los altos, más finos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamanho do padrão de ruído. Valores menores são mais grosseiros e manchados; maiores são mais finos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensioni del motivo di rumore. Valori bassi lo rendono più grossolano e a chiazze, valori alti più fine."
          }
        }
      }
    },
    "Size of the pattern relative to the layer." : {
      "comment" : "Scene Inspector tooltip for an effect parameter named like scale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größe des Musters relativ zur Ebene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille du motif par rapport au calque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño del patrón respecto a la capa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamanho do padrão em relação à camada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensioni del motivo rispetto al livello."
          }
        }
      }
    },
    "Size of the ripples. Low values give broad swells, high values fine ridges." : {
      "comment" : "Scene Inspector tooltip for the waterripple effect's scale parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größe der Wellen. Niedrige Werte ergeben breite Wogen, hohe Werte feine Rillen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille des ondulations. Les faibles valeurs donnent une large houle, les valeurs élevées de fines crêtes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño de las ondas. Los valores bajos dan oleajes amplios; los altos, crestas finas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamanho das ondulações. Valores baixos geram ondas largas; valores altos, cristas finas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensioni delle increspature. Valori bassi danno onde ampie, valori alti creste sottili."
          }
        }
      }
    },
    "Size of the sway pattern. Low values move the whole layer together, high values ripple through it." : {
      "comment" : "Scene Inspector tooltip for the foliagesway effect's scale parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größe des Wiegemusters. Niedrige Werte bewegen die ganze Ebene gemeinsam, hohe Werte lassen Wellen hindurchlaufen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille du motif de balancement. Les faibles valeurs déplacent tout le calque d’un bloc, les valeurs élevées le font onduler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño del patrón de balanceo. Los valores bajos mueven toda la capa a la vez; los altos la recorren en ondas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamanho do padrão de balanço. Valores baixos movem a camada inteira junta; valores altos a percorrem em ondulações."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensioni del motivo di oscillazione. Valori bassi muovono l’intero livello insieme, valori alti lo attraversano a onde."
          }
        }
      }
    },
    "Slides the texture continuously, useful for tiling backgrounds." : {
      "comment" : "Scene Inspector tooltip for the scroll effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt die Textur fortlaufend – nützlich für gekachelte Hintergründe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait défiler la texture en continu, utile pour les arrière-plans en mosaïque."
          }
        },
        "es" : {
