          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "􀄪 켜서 미리보기를 확인하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "􀄪 Włącz, aby zobaczyć podgląd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "􀄪 Ative para ver uma pré-visualização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "􀄪 Включите, чтобы увидеть предварительный просмотр."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
