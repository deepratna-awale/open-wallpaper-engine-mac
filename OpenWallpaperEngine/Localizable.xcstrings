    "Do you want to reset the properties of “%@” back to their defaults?" : {
      "comment" : "Reset confirmation; the wallpaper's title (Wallpaper Engine's wording)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد إعادة تعيين خصائص «%@» إلى قيمها الافتراضية؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie die Eigenschaften von „%@“ auf ihre Standardwerte zurücksetzen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres restablecer las propiedades de «%@» a sus valores predeterminados?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous réinitialiser les propriétés de « %@ » à leurs valeurs par défaut ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप “%@” की प्रॉपर्टी को उनके डिफ़ॉल्ट पर रीसेट करना चाहते हैं?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi ripristinare le proprietà di “%@” ai valori predefiniti?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」のプロパティをデフォルトに戻しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’의 속성을 기본값으로 재설정하시겠습니까?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy chcesz zresetować właściwości „%@” do wartości domyślnych?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseja redefinir as propriedades de “%@” para os padrões?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбросить свойства «%@» до значений по умолчанию?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” özelliklerini varsayılan değerlerine sıfırlamak istiyor musunuz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
