          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona uma distorção de chamas subindo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет искажение в виде поднимающегося пламени."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükselen bir alev bozulması ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає спотворення від полумʼя, що здіймається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
