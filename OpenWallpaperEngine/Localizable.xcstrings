    "Offsets the start of the animation, useful for de-syncing two copies of an effect." : {
      "comment" : "Scene Inspector tooltip for an effect parameter named like phase",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versetzt den Start der Animation – nützlich, um zwei Kopien eines Effekts zu desynchronisieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décale le début de l’animation, utile pour désynchroniser deux copies d’un effet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza el inicio de la animación; útil para desincronizar dos copias de un efecto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
