          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立ち上る炎のゆがみを加えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위로 타오르는 불꽃 왜곡을 추가합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
