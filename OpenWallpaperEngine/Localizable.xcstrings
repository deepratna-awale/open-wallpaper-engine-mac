    "Spacing between bars, as a fraction of their width." : {
      "comment" : "Scene Inspector tooltip for the audiobars effect's gap parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstand zwischen den Balken als Anteil ihrer Breite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacement entre les barres, en fraction de leur largeur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacio entre barras, como fracción de su anchura."
          }
        },
