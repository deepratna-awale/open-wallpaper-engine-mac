          "stringUnit" : {
            "state" : "translated",
            "value" : "Densité des pertes de signal et des parasites."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densidad de cortes y motas de ruido."
          }
        },
