    "It has now done this twice in a row and is flagged in the library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist nun zweimal hintereinander passiert; das Hintergrundbild ist in der Mediathek markiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela s’est produit deux fois de suite ; il est désormais signalé dans la bibliothèque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya ha ocurrido dos veces seguidas y se ha marcado en la biblioteca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso já aconteceu duas vezes seguidas, e ela foi sinalizada na biblioteca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È successo due volte di seguito ed è stato contrassegnato nella libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これで2回連続となったため、ライブラリで警告マークが付けられました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 문제가 연속으로 두 번 발생하여 보관함에 표시되었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
