    "Open Wallpaper Engine didn't quit cleanly twice in a row while this wallpaper was showing" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine wurde zweimal hintereinander nicht ordnungsgemäß beendet, während dieses Hintergrundbild angezeigt wurde"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine ne s’est pas fermé correctement deux fois de suite pendant l’affichage de ce fond d’écran"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine no se cerró correctamente dos veces seguidas mientras se mostraba este fondo de pantalla"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
