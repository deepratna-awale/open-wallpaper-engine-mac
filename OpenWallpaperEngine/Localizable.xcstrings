    "Rocks the layer back and forth around its base." : {
      "comment" : "Scene Inspector tooltip for the swing effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaukelt die Ebene um ihre Basis hin und her."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balance le calque d’avant en arrière autour de sa base."
          }
        },
        "es" : {
          "stringUnit" : {
