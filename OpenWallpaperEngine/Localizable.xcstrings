    "Cached session expired. Please log in with password." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية الجلسة المخزنة. يُرجى تسجيل الدخول باستخدام كلمة المرور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherte Sitzung ist abgelaufen. Bitte melden Sie sich mit Ihrem Passwort an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión guardada ha caducado. Inicia sesión con la contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session en cache a expiré. Veuillez vous connecter avec votre mot de passe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैश किया गया सेशन समाप्त हो गया है. कृपया पासवर्ड से लॉग इन करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione salvata è scaduta. Accedi con la password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッシュされたセッションの有効期限が切れました。パスワードでログインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐시된 세션이 만료되었습니다. 비밀번호로 로그인하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapamiętana sesja wygasła. Zaloguj się za pomocą hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão em cache expirou. Inicie sessão com a senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённый сеанс истёк. Войдите с паролем."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önbellekteki oturumun süresi doldu. Lütfen parolayla giriş yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережений сеанс завершився. Увійдіть за допомогою пароля."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓存的会话已过期。请使用密码登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快取的工作階段已過期。請使用密碼登入。"
          }
        }
      }
    },
