    "How quickly each shake settles. High values give a short sharp jolt, low values keep it wobbling." : {
      "comment" : "Scene Inspector tooltip for the shake effect's friction parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie schnell jedes Wackeln abklingt. Hohe Werte ergeben einen kurzen, harten Ruck, niedrige Werte lassen es weiter wackeln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
