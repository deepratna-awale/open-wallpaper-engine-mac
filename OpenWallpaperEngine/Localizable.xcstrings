    "Simulated camera exposure. Positive brightens, negative darkens." : {
      "comment" : "Scene Inspector tooltip for an effect parameter named like exposure",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulierte Kamerabelichtung. Positive Werte hellen auf, negative dunkeln ab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exposition simulée de l’appareil photo. Une valeur positive éclaircit, une valeur négative assombrit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exposición de cámara simulada. Los valores positivos aclaran; los negativos oscurecen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exposição de câmera simulada. Valores positivos clareiam; negativos escurecem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esposizione simulata della fotocamera. I valori positivi schiariscono, quelli negativi scuriscono."
          }
        }
      }
    },
