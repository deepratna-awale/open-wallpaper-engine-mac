    "Undo every change made to this wallpaper in the Scene Inspector" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التراجع عن كل تغيير أُجري على خلفية الشاشة هذه في مراقب المشهد"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Änderungen an diesem Hintergrundbild im Szeneninspektor widerrufen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deshacer todos los cambios hechos a este fondo de pantalla en el Inspector de escenas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuler toutes les modifications apportées à ce fond d’écran dans l’Inspecteur de scène"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीन इंस्पेक्टर में इस वॉलपेपर में किए गए हर बदलाव को पहले जैसा करें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla ogni modifica fatta a questo sfondo nell’Inspector scena"
          }
