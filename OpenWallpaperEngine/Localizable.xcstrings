    "Playback speed of the soundtrack. Link it to the video speed to keep them in step." : {
      "comment" : "Details panel tooltip",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سرعة تشغيل الموسيقى التصويرية. اربطها بسرعة الفيديو لإبقائهما متزامنتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabegeschwindigkeit des Soundtracks. Verknüpfen Sie sie mit der Videogeschwindigkeit, damit beide synchron bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad de reproducción de la banda sonora. Vincúlala a la velocidad del vídeo para mantenerlos sincronizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse de lecture de la bande-son. Liez-la à la vitesse de la vidéo pour les garder synchronisées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साउंडट्रैक की प्लेबैक स्पीड. दोनों को साथ रखने के लिए इसे वीडियो की स्पीड से लिंक करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocità di riproduzione della colonna sonora. Collegala alla velocità del video per mantenerle sincronizzate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サウンドトラックの再生速度です。ビデオの速度とリンクすると、同期が保たれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사운드트랙의 재생 속도입니다. 비디오 속도와 연결하면 서로 맞춰집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkość odtwarzania ścieżki dźwiękowej. Połącz ją z szybkością wideo, aby zachować synchronizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade de reprodução da trilha sonora. Vincule-a à velocidade do vídeo para mantê-los sincronizados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорость воспроизведения саундтрека. Свяжите её со скоростью видео, чтобы они не расходились."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müziğin oynatma hızı. Uyumlu kalmaları için video hızına bağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Швидкість відтворення саундтреку. Звʼяжіть її зі швидкістю відео, щоб вони йшли синхронно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配乐的播放速度。将其与视频速度关联可保持同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音軌的播放速度。與影片速度連結可讓兩者保持同步。"
          }
        }
      }
    },
    "Playback speed of the video. 1 is normal; 0 pauses it." : {
      "comment" : "Details panel tooltip",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
