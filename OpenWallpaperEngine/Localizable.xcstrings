    "Inspect every layer, texture and effect in a wallpaper, tweak parameters live, and nudge or align objects." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افحص كل طبقة ونسيج وتأثير في الخلفية، وعدّل المعلمات مباشرةً، وحرّك الكائنات قليلًا أو حاذِها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untersuchen Sie jede Ebene, Textur und jeden Effekt eines Hintergrundbilds, passen Sie Parameter live an und verschieben oder richten Sie Objekte aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspecciona cada capa, textura y efecto de un fondo de pantalla, ajusta parámetros en directo y desplaza o alinea objetos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspectez chaque calque, texture et effet d’un fond d’écran, ajustez les paramètres en direct, puis déplacez ou alignez les objets."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी वॉलपेपर की हर लेयर, टेक्सचर और इफ़ेक्ट की जाँच करें, पैरामीटर लाइव बदलें, और ऑब्जेक्ट को खिसकाएँ या अलाइन करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esamina ogni livello, texture ed effetto di uno sfondo, modifica i parametri in tempo reale e sposta o allinea gli oggetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙のすべてのレイヤー、テクスチャ、エフェクトを調べ、パラメータをリアルタイムで調整し、オブジェクトを微調整したり整列したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면의 모든 레이어, 텍스처 및 효과를 검사하고, 매개변수를 실시간으로 조정하며, 객체를 미세하게 이동하거나 정렬할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdzaj każdą warstwę, teksturę i efekt tapety, zmieniaj parametry na żywo oraz przesuwaj i wyrównuj obiekty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspecione cada camada, textura e efeito de uma imagem de fundo, ajuste parâmetros em tempo real e mova ou alinhe objetos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изучайте каждый слой, текстуру и эффект в обоях, настраивайте параметры на лету, сдвигайте и выравнивайте объекты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir duvar kâğıdındaki her katmanı, dokuyu ve efekti inceleyin, parametreleri canlı olarak ayarlayın, nesneleri kaydırın veya hizalayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Досліджуйте кожен шар, текстуру й ефект шпалери, змінюйте параметри наживо та пересувайте або вирівнюйте обʼєкти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查墙纸中的每个图层、纹理和效果，实时调整参数，以及微移或对齐对象。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢視背景圖片中的每個圖層、紋理和效果，即時微調參數，並微移或對齊物件。"
          }
        }
      }
    },
