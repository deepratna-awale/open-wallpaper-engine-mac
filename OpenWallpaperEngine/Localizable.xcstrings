    "Move existing wallpapers to the selected folder, or leave them in the current location and use the new folder from now on?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorhandene Hintergrundbilder in den ausgewählten Ordner bewegen oder am aktuellen Ort belassen und ab jetzt den neuen Ordner verwenden?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacer les fonds d’écran existants vers le dossier sélectionné, ou les laisser à leur emplacement actuel et utiliser le nouveau dossier à partir de maintenant ?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres mover los fondos de pantalla existentes a la carpeta seleccionada, o dejarlos en su ubicación actual y usar la nueva carpeta a partir de ahora?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover as imagens de fundo existentes para a pasta selecionada ou deixá-las no local atual e usar a nova pasta daqui em diante?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi spostare gli sfondi esistenti nella cartella selezionata, oppure lasciarli dove sono e usare la nuova cartella da ora in poi?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存の壁紙を選択したフォルダに移動しますか？それとも現在の場所に残し、今後は新しいフォルダを使用しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 배경화면을 선택한 폴더로 이동하시겠습니까, 아니면 현재 위치에 두고 지금부터 새 폴더를 사용하시겠습니까?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要将现有墙纸移到所选文件夹，还是将它们留在当前位置并从现在起使用新文件夹？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要將現有的背景圖片搬移到所選的檔案夾，還是保留在目前位置，並從現在開始使用新檔案夾？"
          }
        }
      }
    },
