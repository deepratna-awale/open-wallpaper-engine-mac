    "Highest audio frequency band that drives this. Lower it to ignore hiss and cymbals." : {
      "comment" : "Scene Inspector tooltip for an effect parameter named like frequencymax",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchstes Audiofrequenzband, das diesen Wert steuert. Verringern Sie es, um Rauschen und Becken zu ignorieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bande de fréquences audio la plus haute qui pilote ce paramètre. Baissez-la pour ignorer le souffle et les cymbales."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banda de frecuencia de audio más alta que lo controla. Bájala para ignorar el siseo y los platillos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faixa de frequência de áudio mais alta que controla isto. Diminua para ignorar chiados e pratos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banda di frequenza audio più alta che controlla il parametro. Abbassala per ignorare fruscii e piatti."
          }
        }
      }
    },
    "Highest frequency band that drives the shift. Lower it to ignore cymbals and hiss." : {
      "comment" : "Scene Inspector tooltip for the hueshift effect's frequencymax parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchstes Frequenzband, das die Verschiebung steuert. Verringern Sie es, um Becken und Rauschen zu ignorieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bande de fréquences la plus haute qui pilote le décalage. Baissez-la pour ignorer les cymbales et le souffle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banda de frecuencia más alta que controla el cambio. Bájala para ignorar los platillos y el siseo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faixa de frequência mais alta que controla a mudança. Diminua para ignorar pratos e chiados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banda di frequenza più alta che controlla lo spostamento. Abbassala per ignorare piatti e fruscii."
          }
        }
      }
    },
    "Highest frequency band that drives the warp." : {
      "comment" : "Scene Inspector tooltip for the hyperdrive effect's frequencymax parameter",
      "localizations" : {
        "de" : {
