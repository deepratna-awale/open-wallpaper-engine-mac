            "state" : "translated",
            "value" : "Desliza a textura continuamente; útil para fundos que se repetem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa scorrere la texture senza sosta, utile per sfondi ripetuti."
          }
        }
      }
    },
    "Small Icons" : {
      "localizations" : {
        "zh-Hans" : {
