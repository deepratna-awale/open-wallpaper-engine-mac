        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ultra-Modus fügt unterstützten Hintergrundbildern HDR-Bloom hinzu und wird nur für leistungsstarke High-End-Desktop-Grafikkarten empfohlen."
