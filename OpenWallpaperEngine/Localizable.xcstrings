    "Smears the image along its direction of motion." : {
      "comment" : "Scene Inspector tooltip for the motionblur effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلطّخ الصورة على امتداد اتجاه حركتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwischt das Bild entlang seiner Bewegungsrichtung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emborrona la imagen en su dirección de movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étale l’image dans sa direction de mouvement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इमेज को उसकी गति की दिशा में फैलाता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sbava l’immagine lungo la direzione del movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像を動きの方向に沿ってにじませます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지를 움직이는 방향으로 번지게 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmazuje obraz w kierunku ruchu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra a imagem na direção do movimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размазывает изображение в направлении движения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntüyü hareket yönü boyunca bulaştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розмазує зображення в напрямку руху."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
