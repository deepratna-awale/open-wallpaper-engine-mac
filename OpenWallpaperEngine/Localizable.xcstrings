    "These settings are designed for scene wallpapers and may not work as expected for other types." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صُممت هذه الإعدادات لخلفيات المشاهد، وقد لا تعمل كما هو متوقع مع الأنواع الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellungen sind für Szenen-Hintergrundbilder gedacht und funktionieren bei anderen Arten möglicherweise nicht wie erwartet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos ajustes están pensados para fondos de pantalla de escena y puede que no funcionen como se espera con otros tipos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces réglages sont conçus pour les fonds d’écran de type scène et peuvent ne pas fonctionner comme prévu avec les autres types."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये सेटिंग सीन वॉलपेपर के लिए बनाई गई हैं और हो सकता है कि दूसरे प्रकारों के लिए उम्मीद के मुताबिक काम न करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste impostazioni sono pensate per gli sfondi di tipo scena e potrebbero non funzionare come previsto con altri tipi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの設定はシーン壁紙向けに設計されているため、ほかのタイプでは期待どおりに動作しない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정은 장면 배경화면용으로 설계되었으며 다른 유형에서는 예상대로 작동하지 않을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ustawienia są przeznaczone dla tapet typu scena i w przypadku innych typów mogą nie działać zgodnie z oczekiwaniami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes ajustes foram criados para imagens de fundo de cena e podem não funcionar como esperado em outros tipos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти настройки рассчитаны на обои-сцены и могут работать неправильно с другими типами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayarlar sahne duvar kâğıtları için tasarlanmıştır ve diğer türlerde beklendiği gibi çalışmayabilir."
          }
        },
        "uk" : {
