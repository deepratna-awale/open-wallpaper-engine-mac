    "Rotate through a playlist on a timer or when a video ends, and keep the wallpapers you love a click away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechseln Sie Hintergrundbilder einer Playlist nach Zeit oder am Ende eines Videos und halten Sie Ihre Lieblinge nur einen Klick entfernt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites défiler une playlist à intervalles réguliers ou à la fin d’une vidéo, et gardez vos fonds d’écran préférés à portée de clic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rota una playlist con un temporizador o al terminar un vídeo, y ten los fondos de pantalla que te encantan a un clic."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterne entre as imagens de fundo de uma playlist por tempo ou quando um vídeo termina, e mantenha suas favoritas a um clique de distância."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri una playlist a intervalli regolari o al termine di un video, e tieni gli sfondi che ami a portata di clic."
          }
        }
      }
    },
    "Rotates a circular region of the layer." : {
