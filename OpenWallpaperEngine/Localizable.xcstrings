    },
    "Depth where the fog reaches full density. Keep it above Fog Near or the gradient inverts." : {
      "comment" : "Scene Inspector tooltip for the volumetricfog effect's far parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefe, in der der Nebel seine volle Dichte erreicht. Halten Sie den Wert über „Nebel nah“, sonst kehrt sich der Verlauf um."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profondeur à laquelle le brouillard atteint sa densité maximale. Gardez-la supérieure à « Brouillard proche », sinon le dégradé s’inverse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundidad a la que la niebla alcanza su densidad máxima. Mantenla por encima de Niebla cercana o el degradado se invertirá."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundidade em que a névoa atinge a densidade máxima. Mantenha acima de Névoa Próxima, ou o gradiente se inverte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profondità a cui la nebbia raggiunge la massima densità. Mantienila sopra Nebbia vicina o il gradiente si inverte."
          }
        }
      }
    },
    "Depth where the fog starts. Nothing closer than this is fogged." : {
      "comment" : "Scene Inspector tooltip for the volumetricfog effect's near parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefe, in der der Nebel beginnt. Näheres bleibt nebelfrei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profondeur à laquelle commence le brouillard. Rien de plus proche n’est embrumé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundidad a la que empieza la niebla. Nada más cercano recibe niebla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundidade em que a névoa começa. Nada mais próximo que isso recebe névoa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profondità a cui inizia la nebbia. Niente di più vicino viene annebbiato."
          }
        }
      }
    },
