    },
    "The Terms of Use and Privacy Policy are new or have changed. Please read them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شروط الاستخدام وسياسة الخصوصية جديدة أو تغيّرت. يُرجى قراءتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nutzungsbedingungen und die Datenschutzrichtlinie sind neu oder wurden geändert. Bitte lesen Sie sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las condiciones de uso y la política de privacidad son nuevas o han cambiado. Léelas, por favor."
