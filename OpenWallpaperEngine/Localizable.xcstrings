          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите в Steam, чтобы загружать. Это можно сделать на вкладке «Мастерская» или в ассистенте настройки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirmek için Steam’e giriş yapın. Bunu Atölye sekmesinde ya da Kurulum Yardımcısı’nda yapabilirsiniz."
          }
        },
        "uk" : {
