    "Adds a rising flame distortion." : {
      "comment" : "Scene Inspector tooltip for the fire effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt eine aufsteigende Flammenverzerrung hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une distorsion de flammes ascendantes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una distorsión de llamas ascendentes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona uma distorção de chamas subindo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una distorsione a fiamma ascendente."
          }
        }
      }
    },
    "Adds depth-aware fog that thickens toward the bottom of the scene." : {
      "comment" : "Scene Inspector tooltip for the volumetricfog effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt tiefenabhängigen Nebel hinzu, der zum unteren Rand der Szene dichter wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un brouillard tenant compte de la profondeur, qui s’épaissit vers le bas de la scène."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade niebla sensible a la profundidad que se hace más densa hacia la parte inferior de la escena."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona uma névoa sensível à profundidade que se adensa em direção à parte inferior da cena."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una nebbia sensibile alla profondità che si infittisce verso il fondo della scena."
          }
        }
      }
    },
    "Adds directional beams of light across the layer." : {
      "comment" : "Scene Inspector tooltip for the lightshafts effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt gerichtete Lichtstrahlen über die Ebene hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des faisceaux de lumière directionnels sur le calque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade haces de luz direccionales sobre la capa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona feixes de luz direcionais através da camada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge fasci di luce direzionali sul livello."
          }
        }
      }
    },
    "Adds expanding ripples across the surface." : {
      "comment" : "Scene Inspector tooltip for the waterripple effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt sich ausbreitende Wellenringe auf der Oberfläche hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des ondulations qui s’étendent sur la surface."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade ondas que se expanden por la superficie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona ondulações que se expandem pela superfície."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge increspature che si espandono sulla superficie."
          }
        }
      }
    },
    "Adds moving film grain. Keep the amount low or it swamps darker scenes." : {
      "comment" : "Scene Inspector tooltip for the filmgrain effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt bewegtes Filmkorn hinzu. Halten Sie die Stärke niedrig, sonst überdeckt es dunklere Szenen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un grain de film animé. Gardez une quantité faible, sinon il envahit les scènes sombres."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade grano de película en movimiento. Usa una cantidad baja o saturará las escenas más oscuras."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona granulação de filme em movimento. Mantenha a quantidade baixa, ou ela encobre as cenas mais escuras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una grana da pellicola in movimento. Tieni bassa la quantità o sommergerà le scene più scure."
          }
        }
      }
    },
    "Adds scaling with depth so near parts grow as they shift, rather than just sliding." : {
      "comment" : "Scene Inspector tooltip for the depthparallax effect's perspective parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaliert abhängig von der Tiefe, sodass nahe Teile beim Verschieben größer werden, statt nur zu gleiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une mise à l’échelle selon la profondeur : les parties proches grossissent en se déplaçant au lieu de simplement glisser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade escalado según la profundidad para que las partes cercanas crezcan al desplazarse, en lugar de solo deslizarse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona escala conforme a profundidade, para que as partes próximas cresçam ao se deslocar em vez de apenas deslizar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge un ridimensionamento in base alla profondità, così le parti vicine si ingrandiscono mentre si spostano invece di scorrere soltanto."
          }
        }
      }
    },
    "Adds tape distortion, colour bleed and scanlines." : {
      "comment" : "Scene Inspector tooltip for the vhs effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt Bandverzerrung, Farbbluten und Scanlines hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une distorsion de bande, des bavures de couleur et des lignes de balayage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade distorsión de cinta, sangrado de color y líneas de escaneo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona distorção de fita, vazamento de cor e linhas de varredura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge distorsione da nastro, sbavature di colore e linee di scansione."
          }
        }
      }
    },
