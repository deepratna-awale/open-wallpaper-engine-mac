    "Scene effects are toggled under User Scene Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szeneneffekte werden unter „Szeneneinstellungen des Benutzers“ ein- und ausgeschaltet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les effets de la scène s’activent dans « Réglages de scène personnalisés »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los efectos de escena se activan en Ajustes de escena del usuario."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os efeitos da cena são ativados ou desativados em Ajustes de Cena do Usuário."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli effetti della scena si attivano e disattivano in Impostazioni utente della scena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーンエフェクトは「ユーザシーン設定」でオン/オフを切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면 효과는 사용자 장면 설정에서 켜거나 끌 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "场景效果可在“用户场景设置”中开关。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場景效果可在「使用者場景設定」中開關。"
          }
        }
      }
    },
    "Scene rendering, Workshop, multi-display" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szenen-Rendering, Workshop, mehrere Displays"
          }
        },
        "fr" : {
