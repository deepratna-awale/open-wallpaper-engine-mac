    "Height of the torn band. Small values give a thin tracking line, large values disturb most of the frame." : {
      "comment" : "Scene Inspector tooltip for the vhs effect's distortionwidth parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhe des gestörten Streifens. Kleine Werte ergeben eine dünne Tracking-Linie, große Werte stören den Großteil des Bildes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauteur de la bande déchirée. Les petites valeurs donnent une fine ligne de tracking, les grandes perturbent la majeure partie de l’image."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura de la franja rasgada. Los valores bajos crean una línea de tracking fina; los altos alteran casi todo el fotograma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura da faixa rasgada. Valores pequenos geram uma linha fina de tracking; valores grandes perturbam a maior parte do quadro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altezza della banda strappata. Valori bassi danno una sottile linea di tracking, valori alti disturbano gran parte del fotogramma."
          }
        }
      }
    },
    "Height of the waves — how far pixels are displaced." : {
      "comment" : "Scene Inspector tooltip for the waterwaves effect's strength parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhe der Wellen – wie weit Pixel verschoben werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauteur des vagues — distance de déplacement des pixels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura de las olas: cuánto se desplazan los píxeles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura das ondas — o quanto os pixels são deslocados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altezza delle onde, ovvero quanto vengono spostati i pixel."
          }
        }
      }
    },
    "Height the bars keep in silence, so they do not vanish between beats." : {
      "comment" : "Scene Inspector tooltip for the audiobars effect's minimum parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhe, die die Balken bei Stille behalten, damit sie zwischen den Beats nicht verschwinden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauteur conservée par les barres pendant les silences, pour qu’elles ne disparaissent pas entre les temps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura que mantienen las barras en silencio, para que no desaparezcan entre golpes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura que as barras mantêm no silêncio, para não sumirem entre as batidas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altezza che le barre mantengono nel silenzio, così non spariscono tra un battito e l’altro."
          }
        }
      }
    },
