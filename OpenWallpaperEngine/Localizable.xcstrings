    "Pause, mute or switch wallpapers from the menu bar at any time. Open Settings to fine-tune the rest." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف الخلفيات مؤقتًا أو اكتم صوتها أو بدّلها من شريط القائمة في أي وقت. وافتح الإعدادات لضبط الباقي بدقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausieren, stummschalten oder wechseln Sie Hintergrundbilder jederzeit über die Menüleiste. In den Einstellungen passen Sie den Rest an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa, silencia o cambia de fondo de pantalla desde la barra de menús en cualquier momento. Abre Ajustes para ajustar el resto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez en pause, coupez le son ou changez de fond d’écran depuis la barre des menus à tout moment. Ouvrez les Réglages pour peaufiner le reste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेनू बार से कभी भी वॉलपेपर पॉज़, म्यूट या बदलें. बाकी को बारीकी से एडजस्ट करने के लिए सेटिंग खोलें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in pausa, disattiva l’audio o cambia sfondo dalla barra dei menu in qualsiasi momento. Apri Impostazioni per regolare il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーからいつでも壁紙を一時停止、消音、切り替えできます。そのほかの細かい調整は「設定」で行えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언제든지 메뉴 막대에서 배경화면을 일시 정지하거나, 소리를 끄거나, 전환할 수 있습니다. 나머지는 설정에서 세밀하게 조정하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymuj, wyciszaj i zmieniaj tapety z paska menu w dowolnej chwili. Resztę dostroisz w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause, silencie ou troque de imagem de fundo pela barra de menus a qualquer momento. Abra os Ajustes para ajustar o resto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставьте на паузу, выключайте звук или меняйте обои из строки меню в любой момент. Остальное можно настроить в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğundan istediğiniz zaman duvar kâğıtlarını duraklatın, sesini kapatın veya değiştirin. Geri kalanını ince ayarlamak için Ayarlar’ı açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Призупиняйте, вимикайте звук або перемикайте шпалери зі смуги меню будь-коли. Решту можна тонко налаштувати в Параметрах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随时从菜单栏暂停、静音或切换墙纸。打开“设置”可微调其余选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隨時從選單列暫停、靜音或切換背景圖片。打開「設定」即可微調其他項目。"
          }
        }
      }
