    "steamcmd can't accept a double quote or line break in the %@ command." : {
      "comment" : "Login error; steamcmd is a program name, %@ one of its commands",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "steamcmd akzeptiert im Befehl „%@“ keine doppelten Anführungszeichen oder Zeilenumbrüche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "steamcmd n’accepte pas de guillemet droit ni de saut de ligne dans la commande %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "steamcmd no admite comillas dobles ni saltos de línea en el comando %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O steamcmd não aceita aspas duplas nem quebras de linha no comando %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "steamcmd non accetta virgolette doppie o interruzioni di riga nel comando %@."
          }
        }
      }
    },
