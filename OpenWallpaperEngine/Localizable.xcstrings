    "%@ isn't connected. Workshop downloads fail until you connect it or choose another folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist nicht verbunden. Workshop-Downloads schlagen fehl, bis Sie das Volume verbinden oder einen anderen Ordner wählen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas connecté. Les téléchargements du Workshop échoueront tant que vous ne l’aurez pas connecté ou choisi un autre dossier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está conectado. Las descargas del Workshop fallarán hasta que lo conectes o elijas otra carpeta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está conectado. Os downloads da Oficina falharão até que você o conecte ou escolha outra pasta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è collegato. I download dal Workshop non riusciranno finché non lo colleghi o non scegli un’altra cartella."
          }
        }
      }
    },
    "%@ of originals can be removed" : {
      "comment" : "%@ is a file size, e.g. 1.2 GB",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ an Originalen können entfernt werden"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ d’originaux peuvent être supprimés"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pueden eliminar %@ de originales"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de originais podem ser removidos"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi rimuovere %@ di originali"
          }
        }
      }
    },
    "%@ was stopped because Open Wallpaper Engine didn't quit cleanly last time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde gestoppt, da Open Wallpaper Engine beim letzten Mal nicht ordnungsgemäß beendet wurde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été arrêté, car Open Wallpaper Engine ne s’est pas fermé correctement la dernière fois."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha detenido %@ porque Open Wallpaper Engine no se cerró correctamente la última vez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Open Wallpaper Engine interrompeu %@ porque não foi encerrado corretamente da última vez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato interrotto perché l’ultima volta Open Wallpaper Engine non è stato chiuso correttamente."
          }
        }
      }
    },
    "%@ was stopped because it made Open Wallpaper Engine unresponsive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde gestoppt, da Open Wallpaper Engine dadurch nicht mehr reagiert hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été arrêté, car il empêchait Open Wallpaper Engine de répondre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha detenido %@ porque hacía que Open Wallpaper Engine no respondiera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Open Wallpaper Engine interrompeu %@ porque isso fez o app parar de responder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato interrotto perché bloccava Open Wallpaper Engine."
          }
        }
      }
    },
