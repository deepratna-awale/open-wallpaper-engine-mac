            "value" : "Vertikale Scrollgeschwindigkeit. Negative Werte scrollen nach oben, 0 stoppt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse de défilement vertical. Une valeur négative défile vers le haut, 0 arrête."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad de desplazamiento vertical. Los valores negativos desplazan hacia arriba; 0 lo detiene."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade de rolagem vertical. Valores negativos rolam para cima; 0 para."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocità di scorrimento verticale. I valori negativi scorrono verso l’alto, 0 si ferma."
          }
        },
        "ja" : {
          "stringUnit" : {
