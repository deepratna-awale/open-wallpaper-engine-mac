    "Adjust volume, playback speed, placement and any property the wallpaper's author exposed, right from the details sidebar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie Lautstärke, Wiedergabegeschwindigkeit, Platzierung und alle vom Autor des Hintergrundbilds freigegebenen Eigenschaften direkt in der Detail-Seitenleiste an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez le volume, la vitesse de lecture, la disposition et toutes les propriétés proposées par l’auteur du fond d’écran, directement depuis la barre latérale des détails."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el volumen, la velocidad de reproducción, la colocación y cualquier propiedad que haya expuesto el autor del fondo de pantalla, directamente desde la barra lateral de detalles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o volume, a velocidade de reprodução, o posicionamento e qualquer propriedade exposta pelo autor da imagem de fundo, direto na barra lateral de detalhes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola il volume, la velocità di riproduzione, la posizione e ogni proprietà resa disponibile dall’autore dello sfondo, direttamente dalla barra laterale dei dettagli."
          }
        }
      }
    },
