    "A placeholder that does nothing. Authors use it to reserve a slot in the effect stack." : {
      "comment" : "Scene Inspector tooltip for the empty effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عنصر نائب لا يقوم بأي شيء. يستخدمه المؤلفون لحجز موضع في مجموعة التأثيرات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Platzhalter ohne Funktion. Autoren reservieren damit einen Platz im Effektstapel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un marcador de posición que no hace nada. Los autores lo usan para reservar un hueco en la pila de efectos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un espace réservé sans effet. Les auteurs l’utilisent pour réserver un emplacement dans la pile d’effets."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक प्लेसहोल्डर जो कुछ नहीं करता. लेखक इसका उपयोग इफ़ेक्ट स्टैक में जगह आरक्षित करने के लिए करते हैं."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un segnaposto che non fa nulla. Gli autori lo usano per riservare una posizione nella pila degli effetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何もしないプレースホルダです。作成者がエフェクトスタックの枠を確保するために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무 작업도 하지 않는 자리 표시자입니다. 제작자가 효과 스택에 자리를 확보하는 데 사용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Element zastępczy, który nic nie robi. Autorzy używają go, aby zarezerwować miejsce na stosie efektów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um marcador de posição que não faz nada. Os autores o usam para reservar uma posição na pilha de efeitos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заглушка, которая ничего не делает. Авторы используют её, чтобы зарезервировать место в стеке эффектов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir şey yapmayan bir yer tutucu. Yazarlar bunu efekt yığınında bir yer ayırmak için kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заповнювач, який нічого не робить. Автори використовують його, щоб зарезервувати місце в стеку ефектів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不执行任何操作的占位效果。作者用它在效果堆栈中预留位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不產生任何作用的佔位項目。作者用它在效果堆疊中預留位置。"
          }
        }
      }
    },
