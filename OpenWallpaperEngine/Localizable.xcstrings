    "SteamCMD couldn't update itself (exit code %lld): %@" : {
      "comment" : "Error installing SteamCMD: its self-update failed. %1$lld is the exit code, %2$@ is SteamCMD's last output line",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على SteamCMD تحديث نفسه (رمز الخروج %1$lld): %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD konnte sich nicht aktualisieren (Exit-Code %1$lld): %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD no ha podido actualizarse (código de salida %1$lld): %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD n’a pas pu se mettre à jour (code de sortie %1$lld) : %2$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD खुद को अपडेट नहीं कर सका (एग्ज़िट कोड %1$lld): %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD non è riuscito ad aggiornarsi (codice di uscita %1$lld): %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD を自己アップデートできませんでした（終了コード %1$lld）：%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD가 자체 업데이트하지 못했습니다(종료 코드 %1$lld): %2$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD nie mógł się zaktualizować (kod wyjścia %1$lld): %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SteamCMD não conseguiu se atualizar (código de saída %1$lld): %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD не удалось обновиться (код выхода %1$lld): %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD kendini güncelleyemedi (çıkış kodu %1$lld): %2$@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD не вдалося оновитися (код виходу %1$lld): %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 无法自我更新（退出代码 %1$lld）：%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 無法自行更新（結束代碼 %1$lld）：%2$@"
          }
        }
      }
    },
    "SteamCMD has no saved login for %@. Log in to Steam again, then install the assets." : {
      "comment" : "Assets install error; %@ is a Steam account name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي SteamCMD على تسجيل دخول محفوظ للحساب %@. سجّل الدخول إلى Steam مرة أخرى، ثم ثبّت الأصول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD hat keine gespeicherte Anmeldung für %@. Melde dich erneut bei Steam an und installiere dann die Assets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD no tiene un inicio de sesión guardado para %@. Vuelve a iniciar sesión en Steam y luego instala los recursos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD n’a aucune connexion enregistrée pour %@. Reconnectez-vous à Steam, puis installez les ressources."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD में %@ का कोई सहेजा गया लॉगिन नहीं है। Steam में फिर से लॉग इन करें, फिर एसेट इंस्टॉल करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD non ha un accesso salvato per %@. Accedi di nuovo a Steam, poi installa le risorse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD に %@ の保存済みログインがありません。Steam にもう一度ログインしてから、アセットをインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD에 %@의 저장된 로그인이 없습니다. Steam에 다시 로그인한 다음 에셋을 설치하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD nie ma zapisanego logowania dla %@. Zaloguj się ponownie do Steam, a następnie zainstaluj zasoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SteamCMD não tem um login salvo para %@. Entre no Steam novamente e depois instale os recursos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В SteamCMD нет сохранённого входа для %@. Снова войдите в Steam, затем установите ресурсы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD’de %@ için kayıtlı oturum yok. Steam’e yeniden giriş yapın, ardından varlıkları yükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У SteamCMD немає збереженого входу для %@. Знову увійдіть у Steam, а потім установіть ресурси."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 没有 %@ 的已保存登录。请重新登录 Steam，然后安装资源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 沒有 %@ 的已儲存登入。請重新登入 Steam，然後安裝資源。"
          }
        }
      }
    },
    "SteamCMD has no saved login for this account. Finish signing in in Terminal, then try again." : {
      "comment" : "Error after the user clicked I've Signed In but SteamCMD has no cached login",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد في SteamCMD تسجيل دخول محفوظ لهذا الحساب. أكمل تسجيل الدخول في Terminal، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD hat keine gespeicherte Anmeldung für diesen Account. Schließen Sie die Anmeldung im Terminal ab und versuchen Sie es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD no tiene ningún inicio de sesión guardado para esta cuenta. Termina de iniciar sesión en Terminal y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD n’a aucune connexion enregistrée pour ce compte. Terminez la connexion dans Terminal, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD में इस खाते के लिए कोई सहेजा गया लॉग इन नहीं है. टर्मिनल में साइन इन पूरा करें, फिर से कोशिश करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD non ha un accesso salvato per questo account. Completa l’accesso in Terminale, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD にこのアカウントの保存済みログインがありません。ターミナルでサインインを完了してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD에 이 계정의 저장된 로그인이 없습니다. 터미널에서 로그인을 완료한 후 다시 시도하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD nie ma zapisanego logowania dla tego konta. Dokończ logowanie w Terminalu, a następnie spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SteamCMD não tem uma sessão salva para esta conta. Termine de iniciar sessão no Terminal e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В SteamCMD нет сохранённого входа для этой учётной записи. Завершите вход в Терминале и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD’de bu hesap için kayıtlı giriş yok. Terminal’de girişi tamamlayıp yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У SteamCMD немає збереженого входу для цього облікового запису. Завершіть вхід у Терміналі, а потім спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 中没有此账户的已存储登录。请在“终端”中完成登录，然后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 中沒有此帳號的已儲存登入。請在「終端機」中完成登入，然後再試一次。"
          }
        }
      }
    },
