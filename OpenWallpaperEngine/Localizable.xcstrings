    "Play scene, video, web and image wallpapers, with a familiar layout if you already know Wallpaper Engine." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل خلفيات المشاهد والفيديو والويب والصور، بتخطيط مألوف إذا كنت تعرف Wallpaper Engine بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie Szenen-, Video-, Web- und Bild-Hintergrundbilder wieder – mit einem vertrauten Layout, wenn Sie Wallpaper Engine bereits kennen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce fondos de pantalla de escena, vídeo, web e imagen, con una disposición familiar si ya conoces Wallpaper Engine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez des fonds d’écran de type scène, vidéo, web et image, avec une présentation familière si vous connaissez déjà Wallpaper Engine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीन, वीडियो, वेब और इमेज वॉलपेपर चलाएँ; अगर आप Wallpaper Engine जानते हैं, तो लेआउट जाना-पहचाना लगेगा."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduci sfondi di tipo scena, video, web e immagine, con un layout familiare se conosci già Wallpaper Engine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーン、ビデオ、Web、画像の壁紙を再生できます。Wallpaper Engineをご存じなら、見慣れたレイアウトで使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면, 비디오, 웹 및 이미지 배경화면을 재생하며, Wallpaper Engine을 이미 사용해 봤다면 익숙한 레이아웃으로 사용할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarzaj tapety typu scena, wideo, sieć i obraz w układzie, który znasz z Wallpaper Engine."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduza imagens de fundo de cena, vídeo, web e imagem, com um layout familiar se você já conhece o Wallpaper Engine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводите обои типов «Сцена», «Видео», «Веб» и изображения в привычном интерфейсе, если вы уже знакомы с Wallpaper Engine."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sahne, video, web ve görüntü duvar kâğıtlarını oynatın; Wallpaper Engine’i zaten biliyorsanız tanıdık bir yerleşimle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відтворюйте шпалери-сцени, відео, вебшпалери та зображення у звичному інтерфейсі, якщо ви вже знаєте Wallpaper Engine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放场景、视频、网页和图像墙纸。如果你熟悉 Wallpaper Engine，布局也会很熟悉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放場景、影片、網頁和影像背景圖片；如果你熟悉 Wallpaper Engine，也會覺得版面似曾相識。"
          }
        }
      }
    },
