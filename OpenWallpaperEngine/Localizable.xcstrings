          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要将“%@”的属性重置为默认值吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要將「%@」的屬性重置為預設值嗎？"
          }
        }
      }
    },
    "Do you want to undo every Scene Inspector edit of “%@”? Its properties are kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد التراجع عن كل تعديلات مراقب المشهد على «%@»؟ يتم الاحتفاظ بخصائصها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie alle Änderungen an „%@“ im Szeneninspektor widerrufen? Die Eigenschaften bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres deshacer todos los cambios del Inspector de escenas en «%@»? Sus propiedades se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous annuler toutes les modifications de « %@ » faites dans l’Inspecteur de scène ? Ses propriétés sont conservées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप “%@” में सीन इंस्पेक्टर के हर बदलाव को पहले जैसा करना चाहते हैं? इसकी प्रॉपर्टी बनी रहेंगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi annullare ogni modifica a “%@” fatta nell’Inspector scena? Le sue proprietà vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」へのシーンインスペクタでの編集をすべて取り消しますか？プロパティは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’에 대한 장면 인스펙터 편집 내용을 모두 취소하시겠습니까? 속성은 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy chcesz cofnąć wszystkie zmiany „%@” wprowadzone w Inspektorze sceny? Jej właściwości zostaną zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseja desfazer todas as edições do Inspetor de Cena em “%@”? As propriedades são mantidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отменить все изменения «%@», сделанные в Инспекторе сцены? Свойства сохранятся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” için tüm Sahne Denetçisi düzenlemelerini geri almak istiyor musunuz? Özellikleri korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скасувати всі зміни «%@», зроблені в Інспекторі сцени? Властивості збережуться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
