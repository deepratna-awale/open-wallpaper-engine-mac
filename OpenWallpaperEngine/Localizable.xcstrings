    "Adds a rising flame distortion." : {
      "comment" : "Scene Inspector tooltip for the fire effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف تشوهًا متصاعدًا يشبه اللهب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt eine aufsteigende Flammenverzerrung hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una distorsión de llamas ascendentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une distorsion de flammes ascendantes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊपर उठती लपटों जैसा डिस्टॉर्शन जोड़ता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
