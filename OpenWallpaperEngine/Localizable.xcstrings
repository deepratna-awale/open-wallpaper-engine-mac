    "How thick the fog is. Small changes read strongly — start low." : {
      "comment" : "Scene Inspector tooltip for the volumetricfog effect's density parameter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كثافة الضباب. للتغييرات الصغيرة أثر واضح — ابدأ بقيمة منخفضة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie dicht der Nebel ist. Kleine Änderungen wirken stark – beginnen Sie niedrig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densidad de la niebla. Los cambios pequeños se notan mucho: empieza con valores bajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épaisseur du brouillard. De petits changements se voient beaucoup — commencez bas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोहरा कितना घना है. छोटे बदलाव भी साफ़ दिखते हैं — कम मान से शुरू करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spessore della nebbia. Anche piccole modifiche si notano molto: inizia con valori bassi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォグの濃さです。わずかな変更でも強く表れるため、低い値から始めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안개의 짙은 정도입니다. 작은 변화도 크게 보이므로 낮은 값부터 시작하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gęstość mgły. Nawet małe zmiany są wyraźne — zacznij od niskiej wartości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A espessura da névoa. Pequenas mudanças são bem perceptíveis — comece com valores baixos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плотность тумана. Даже небольшие изменения заметны — начинайте с малых значений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisin ne kadar yoğun olduğu. Küçük değişiklikler belirgin görünür — düşük bir değerle başlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наскільки густий туман. Навіть малі зміни помітні — починайте з малого."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
