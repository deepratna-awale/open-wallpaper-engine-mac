    "This wallpaper was showing when Open Wallpaper Engine crashed, hung or was force-quit twice in a row. It may do so again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Hintergrundbild wurde angezeigt, als Open Wallpaper Engine zweimal hintereinander abgestürzt ist, nicht mehr reagiert hat oder sofort beendet wurde. Das kann erneut passieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fond d’écran était affiché lorsqu’Open Wallpaper Engine a planté, s’est bloqué ou a été forcé à quitter deux fois de suite. Cela pourrait se reproduire."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
