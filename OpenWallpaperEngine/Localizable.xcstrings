        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응용 프로그램 배경화면은 항상 제외됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapety typu aplikacja są zawsze pomijane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagens de fundo do tipo aplicativo sempre ficam de fora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
