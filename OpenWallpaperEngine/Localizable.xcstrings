    "Makes colours richer on loud passages. %@" : {
      "comment" : "%@ is the music sync explanation",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجعل الألوان أغنى في المقاطع الصاخبة. %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
