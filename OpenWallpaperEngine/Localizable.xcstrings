    "Vertical scroll speed. Negative scrolls up, 0 stops." : {
      "comment" : "Scene Inspector tooltip for the scroll effect's speedy parameter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سرعة التمرير العمودي. القيم السالبة تمرّر إلى أعلى، و0 يوقفه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikale Scrollgeschwindigkeit. Negative Werte scrollen nach oben, 0 stoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad de desplazamiento vertical. Los valores negativos desplazan hacia arriba; 0 lo detiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse de défilement vertical. Une valeur négative défile vers le haut, 0 arrête."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लंबवत स्क्रॉल स्पीड. ऋणात्मक मान ऊपर स्क्रॉल करता है, 0 रोक देता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocità di scorrimento verticale. I valori negativi scorrono verso l’alto, 0 si ferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "縦方向のスクロール速度です。負の値で上へスクロールし、0で停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세로 스크롤 속도입니다. 음수이면 위로 스크롤되고, 0이면 멈춥니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkość przewijania w pionie. Wartości ujemne przewijają w górę, 0 zatrzymuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade de rolagem vertical. Valores negativos rolam para cima; 0 para."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорость прокрутки по вертикали. Отрицательные значения — вверх, 0 — остановка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikey kaydırma hızı. Negatif değer yukarı kaydırır, 0 durdurur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Швидкість вертикальної прокрутки. Відʼємні значення прокручують угору, 0 зупиняє."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "垂直滚动速度。负值向上滚动，0 为停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "垂直捲動速度。負值向上捲動，0 為停止。"
          }
        }
      }
    },
    "Vertical speed. Negative values move the other way, 0 stops." : {
      "comment" : "Scene Inspector tooltip for an effect parameter named like speedy",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السرعة العمودية. القيم السالبة تحرّك في الاتجاه المعاكس، و0 يوقف الحركة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikale Geschwindigkeit. Negative Werte bewegen in die Gegenrichtung, 0 stoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad vertical. Los valores negativos mueven en sentido contrario; 0 lo detiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse verticale. Les valeurs négatives vont dans l’autre sens, 0 arrête."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लंबवत स्पीड. ऋणात्मक मान उल्टी दिशा में ले जाते हैं, 0 रोक देता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocità verticale. I valori negativi muovono nella direzione opposta, 0 si ferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "縦方向の速度です。負の値で逆方向に動き、0で停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세로 속도입니다. 음수이면 반대 방향으로 움직이고, 0이면 멈춥니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkość w pionie. Wartości ujemne odwracają kierunek, 0 zatrzymuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade vertical. Valores negativos movem no sentido oposto; 0 para."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорость по вертикали. Отрицательные значения — в обратную сторону, 0 — остановка."
