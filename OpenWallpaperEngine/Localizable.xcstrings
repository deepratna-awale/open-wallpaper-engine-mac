    },
    "Fades the layer into a gradient, usually to darken edges or tint one side." : {
      "comment" : "Scene Inspector tooltip for the blendgradient effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet die Ebene in einen Verlauf über, meist um Ränder abzudunkeln oder eine Seite einzufärben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fond le calque dans un dégradé, généralement pour assombrir les bords ou teinter un côté."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funde la capa en un degradado, normalmente para oscurecer los bordes o teñir un lado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funde a camada em um gradiente, geralmente para escurecer as bordas ou tingir um dos lados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfuma il livello in un gradiente, di solito per scurire i bordi o colorare un lato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイヤーをグラデーションに溶け込ませます。主に端を暗くしたり、片側に色合いを付けたりするために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이어를 그레이디언트로 페이드하며, 주로 가장자리를 어둡게 하거나 한쪽에 색조를 입히는 데 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
