          }
        }
      }
    },
    "Adds depth-aware fog that thickens toward the bottom of the scene." : {
      "comment" : "Scene Inspector tooltip for the volumetricfog effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف ضبابًا يراعي العمق ويزداد كثافة باتجاه أسفل المشهد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt tiefenabhängigen Nebel hinzu, der zum unteren Rand der Szene dichter wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade niebla sensible a la profundidad que se hace más densa hacia la parte inferior de la escena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un brouillard tenant compte de la profondeur, qui s’épaissit vers le bas de la scène."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेप्थ के अनुसार कोहरा जोड़ता है, जो सीन के निचले हिस्से की ओर घना होता जाता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una nebbia sensibile alla profondità che si infittisce verso il fondo della scena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーンの下部に向かって濃くなる、深度を考慮したフォグを加えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면 아래쪽으로 갈수록 짙어지는 깊이 기반 안개를 추가합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje mgłę uwzględniającą głębię, która gęstnieje ku dołowi sceny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona uma névoa sensível à profundidade que se adensa em direção à parte inferior da cena."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет туман с учётом глубины, который сгущается к низу сцены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sahnenin altına doğru yoğunlaşan, derinliğe duyarlı sis ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає туман з урахуванням глибини, який густішає до низу сцени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加基于深度的雾，越靠近场景底部越浓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入依深度變化、越接近場景底部越濃的霧。"
          }
        }
      }
    },
    "Adds directional beams of light across the layer." : {
      "comment" : "Scene Inspector tooltip for the lightshafts effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف حزمًا ضوئية موجّهة عبر الطبقة."
          }
        },
        "de" : {
          "stringUnit" : {
