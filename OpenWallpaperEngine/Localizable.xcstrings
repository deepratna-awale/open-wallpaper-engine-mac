    "It has now done this twice in a row and is flagged in the library." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكرر ذلك الآن مرتين متتاليتين، وتم تمييزها في المكتبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist nun zweimal hintereinander passiert; das Hintergrundbild ist in der Mediathek markiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya ha ocurrido dos veces seguidas y se ha marcado en la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela s’est produit deux fois de suite ; il est désormais signalé dans la bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अब यह लगातार दो बार ऐसा कर चुका है और लाइब्रेरी में फ़्लैग कर दिया गया है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È successo due volte di seguito ed è stato contrassegnato nella libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これで2回連続となったため、ライブラリで警告マークが付けられました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 문제가 연속으로 두 번 발생하여 보관함에 표시되었습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stało się tak już dwa razy z rzędu, więc tapeta została oznaczona w bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso já aconteceu duas vezes seguidas, e ela foi sinalizada na biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это произошло уже дважды подряд, поэтому обои отмечены в библиотеке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu durum art arda ikinci kez yaşandı ve arşivde işaretlendi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це сталося вже двічі поспіль, тож у бібліотеці її позначено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已连续两次出现此情况，并已在墙纸库中被标记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已連續發生兩次，並已在資料庫中標示。"
          }
        }
      }
    },
