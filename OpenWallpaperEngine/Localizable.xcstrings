          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Условия использования и политика конфиденциальности новые или изменились. Пожалуйста, прочитайте их."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanım Koşulları ve Gizlilik Politikası yeni veya değişti. Lütfen okuyun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умови використання та політика приватності нові або змінилися. Будь ласка, прочитайте їх."
