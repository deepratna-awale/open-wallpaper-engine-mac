    "A Steam Web API key is required to browse." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Durchsuchen ist ein Steam-Web-API-Schlüssel erforderlich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une clé d’API Web Steam est requise pour parcourir le Workshop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita una clave de la API web de Steam para explorar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessária uma chave de API Web do Steam para explorar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per sfogliare è necessaria una chiave Steam Web API."
          }
        }
      }
    },
    "A higher quality, more expensive blur. Prefer it for large radii where the fast blur shows banding." : {
      "comment" : "Scene Inspector tooltip for the blurprecise effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine hochwertigere, aber aufwendigere Weichzeichnung. Empfohlen für große Radien, bei denen die schnelle Weichzeichnung Streifen zeigt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un flou de meilleure qualité, mais plus coûteux. À privilégier pour les grands rayons, où le flou rapide produit des effets de bandes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un desenfoque de mayor calidad y más costoso. Úsalo con radios grandes, donde el desenfoque rápido muestra bandas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um desfoque de maior qualidade e mais pesado. Prefira-o para raios grandes, em que o desfoque rápido apresenta faixas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sfocatura di qualità superiore ma più pesante. Preferiscila per raggi ampi, dove la sfocatura rapida mostra bande."
          }
        }
      }
    },
    "A live wallpaper engine for macOS" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
