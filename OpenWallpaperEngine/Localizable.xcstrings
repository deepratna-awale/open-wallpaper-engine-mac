    "Pick the frame rate, anti-aliasing and texture quality that suit your Mac, and check the Diagnostics page to see the impact." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر معدل الإطارات ومانع التشويش وجودة الأنسجة التي تناسب جهاز Mac، وتحقق من صفحة التشخيصات لمعرفة التأثير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie Bildrate, Antialiasing und Texturqualität passend für Ihren Mac und sehen Sie die Auswirkungen im Bereich „Diagnose“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la velocidad de fotogramas, el suavizado de contorno y la calidad de las texturas que mejor le vayan a tu Mac, y consulta la página Diagnóstico para ver el impacto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la fréquence d’images, l’anticrénelage et la qualité des textures adaptés à votre Mac, et consultez la page Diagnostic pour en voir l’impact."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने Mac के अनुकूल फ़्रेम दर, एंटीएलियासिंग और टेक्सचर गुणवत्ता चुनें, और असर देखने के लिए डायग्नॉस्टिक पेज देखें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la frequenza fotogrammi, l’anti-aliasing e la qualità delle texture più adatti al tuo Mac e controlla la pagina Diagnosi per vederne l’impatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いのMacに合ったフレームレート、アンチエイリアシング、テクスチャ品質を選択し、「診断」ページで影響を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에 맞는 프레임 속도, 앤티앨리어싱 및 텍스처 품질을 선택하고 진단 페이지에서 그 영향을 확인하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz liczbę klatek, antyaliasing i jakość tekstur odpowiednie dla Twojego Maca, a ich wpływ sprawdź na stronie Diagnostyka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a taxa de quadros, a suavização e a qualidade de textura adequadas ao seu Mac e consulte a página Diagnóstico para ver o impacto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите частоту кадров, сглаживание и качество текстур под свой Mac и оцените результат на странице «Диагностика»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac’inize uygun kare hızını, kenar yumuşatmayı ve doku kalitesini seçin; etkisini görmek için Tanılar sayfasına bakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть частоту кадрів, згладжування та якість текстур, які підходять вашому Mac, і подивіться на сторінці «Діагностика», як це впливає на роботу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择适合你的 Mac 的帧速率、抗锯齿和纹理质量，并在“诊断”页面中查看其影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇適合你 Mac 的畫面播放速率、消除鋸齒和紋理品質，並在「診斷」頁面查看影響。"
          }
        }
      }
    },
