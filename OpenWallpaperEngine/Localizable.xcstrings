    "Couldn't check for a Wallpaper Engine update, so nothing was downloaded: %@ To download anyway, choose Re-download." : {
      "comment" : "Assets update check error; %@ is the reason SteamCMD gave",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التحقق من وجود تحديث لـ Wallpaper Engine، لذا لم يُنزَّل شيء: %@ للتنزيل على أي حال، اختر «إعادة التنزيل»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte nicht nach einem Wallpaper Engine-Update gesucht werden, daher wurde nichts geladen: %@ Um trotzdem zu laden, wähle „Erneut laden“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo buscar una actualización de Wallpaper Engine, así que no se descargó nada: %@ Para descargar de todos modos, elige Volver a descargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de rechercher une mise à jour de Wallpaper Engine, rien n’a donc été téléchargé : %@ Pour télécharger quand même, choisissez Retélécharger."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine अपडेट की जाँच नहीं हो सकी, इसलिए कुछ भी डाउनलोड नहीं हुआ: %@ फिर भी डाउनलोड करने के लिए, फिर से डाउनलोड करें चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile cercare un aggiornamento di Wallpaper Engine, quindi non è stato scaricato nulla: %@ Per scaricare comunque, scegli Scarica di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine のアップデートを確認できなかったため、何もダウンロードしませんでした: %@ それでもダウンロードするには、「再ダウンロード」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine 업데이트를 확인할 수 없어 아무것도 다운로드하지 않았습니다: %@ 그래도 다운로드하려면 다시 다운로드를 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się sprawdzić aktualizacji Wallpaper Engine, więc nic nie zostało pobrane: %@ Aby mimo to pobrać, wybierz Pobierz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar se há uma atualização do Wallpaper Engine, então nada foi baixado: %@ Para baixar mesmo assim, escolha Baixar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось проверить наличие обновления Wallpaper Engine, поэтому ничего не загружено: %@ Чтобы загрузить всё равно, выберите «Загрузить заново»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine güncellemesi denetlenemedi, bu yüzden hiçbir şey indirilmedi: %@ Yine de indirmek için Yeniden İndir’i seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося перевірити наявність оновлення Wallpaper Engine, тому нічого не викачано: %@ Щоб викачати все одно, виберіть «Викачати знову»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法检查 Wallpaper Engine 更新，因此未下载任何内容：%@ 若仍要下载，请选择“重新下载”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法檢查 Wallpaper Engine 更新，因此未下載任何內容：%@ 若仍要下載，請選擇「重新下載」。"
          }
        }
      }
    },
