        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec votre compte Steam pour parcourir et télécharger des fonds d’écran.\nVous devez posséder Wallpaper Engine sur Steam."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉलपेपर ब्राउज़ और डाउनलोड करने के लिए अपने Steam अकाउंट से लॉग इन करें.\nआपके पास Steam पर Wallpaper Engine होना चाहिए."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con il tuo account Steam per sfogliare e scaricare sfondi.\nDevi possedere Wallpaper Engine su Steam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙をブラウズしてダウンロードするには、Steamアカウントでログインしてください。\nSteamでWallpaper Engineを所有している必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면을 탐색하고 다운로드하려면 Steam 계정으로 로그인하십시오.\nSteam에서 Wallpaper Engine을 보유하고 있어야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się na konto Steam, aby przeglądać i pobierać tapety.\nMusisz posiadać Wallpaper Engine na Steam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão com sua conta Steam para explorar e baixar imagens de fundo.\nVocê precisa ter o Wallpaper Engine no Steam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите с учётной записью Steam, чтобы просматривать и загружать обои.\nWallpaper Engine должен быть куплен в Steam."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duvar kâğıtlarına göz atmak ve indirmek için Steam hesabınızla giriş yapın.\nSteam’de Wallpaper Engine’e sahip olmanız gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увійдіть в обліковий запис Steam, щоб переглядати й викачувати шпалери.\nВи маєте володіти Wallpaper Engine у Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你的 Steam 账户登录以浏览和下载墙纸。\n你必须在 Steam 上拥有 Wallpaper Engine。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你的 Steam 帳號登入來瀏覽和下載背景圖片。\n你必須在 Steam 上擁有 Wallpaper Engine。"
          }
        }
      }
    },
