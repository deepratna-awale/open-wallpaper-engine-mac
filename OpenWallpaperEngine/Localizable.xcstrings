    "Fades the layer in or out." : {
      "comment" : "Scene Inspector tooltip for the opacity effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُظهر الطبقة أو يخفيها تدريجيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet die Ebene ein oder aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace aparecer o desaparecer la capa gradualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait apparaître ou disparaître le calque en fondu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेयर को फ़ेड इन या फ़ेड आउट करता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa comparire o scomparire gradualmente il livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイヤーをフェードイン/フェードアウトします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이어를 페이드 인하거나 페이드 아웃합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopniowo pokazuje lub ukrywa warstwę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz a camada aparecer ou desaparecer gradualmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавно проявляет или скрывает слой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katmanı yavaşça belirginleştirir veya soldurur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавно проявляє або приховує шар."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使图层淡入或淡出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓圖層淡入或淡出。"
          }
        }
      }
    },
    "Fades the layer into a gradient, usually to darken edges or tint one side." : {
      "comment" : "Scene Inspector tooltip for the blendgradient effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدمج الطبقة تدريجيًا في تدرج لوني، عادةً لتعتيم الحواف أو تلوين جانب واحد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet die Ebene in einen Verlauf über, meist um Ränder abzudunkeln oder eine Seite einzufärben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funde la capa en un degradado, normalmente para oscurecer los bordes o teñir un lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fond le calque dans un dégradé, généralement pour assombrir les bords ou teinter un côté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेयर को ग्रेडिएंट में फ़ेड करता है, आमतौर पर किनारों को गहरा करने या एक तरफ़ रंग देने के लिए."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfuma il livello in un gradiente, di solito per scurire i bordi o colorare un lato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイヤーをグラデーションに溶け込ませます。主に端を暗くしたり、片側に色合いを付けたりするために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이어를 그레이디언트로 페이드하며, 주로 가장자리를 어둡게 하거나 한쪽에 색조를 입히는 데 사용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechodzi warstwą w gradient, zwykle by przyciemnić krawędzie lub zabarwić jedną stronę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funde a camada em um gradiente, geralmente para escurecer as bordas ou tingir um dos lados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавно переводит слой в градиент — обычно чтобы затемнить края или тонировать одну сторону."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katmanı bir degradeye doğru soldurur; genellikle kenarları koyulaştırmak veya bir tarafı renklendirmek için kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавно переводить шар у градієнт — зазвичай щоб затемнити краї або підфарбувати один бік."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使图层渐变过渡，通常用于压暗边缘或为一侧着色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓圖層淡入漸層，通常用於加深邊緣或為一側染色。"
          }
        }
      }
    },
