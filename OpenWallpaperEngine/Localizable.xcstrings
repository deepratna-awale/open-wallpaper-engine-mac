    "Steam didn't return your subscriptions. Import a collection or a Steam library instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُرجع Steam اشتراكاتك. استورد مجموعة أو مكتبة Steam بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam hat Ihre Abonnements nicht zurückgegeben. Importieren Sie stattdessen eine Kollektion oder eine Steam-Bibliothek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam no ha devuelto tus suscripciones. Importa una colección o una biblioteca de Steam en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam n’a pas renvoyé vos abonnements. Importez plutôt une collection ou une bibliothèque Steam."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam ने आपके सब्सक्रिप्शन नहीं लौटाए। इसके बजाय कोई कलेक्शन या Steam लाइब्रेरी इंपोर्ट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam non ha restituito le tue sottoscrizioni. Importa invece una raccolta o una libreria Steam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam からサブスクライブしたアイテムが返されませんでした。代わりにコレクションか Steam ライブラリを読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam이 구독 목록을 반환하지 않았습니다. 대신 컬렉션이나 Steam 라이브러리를 가져오십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam nie zwrócił Twoich subskrypcji. Zamiast tego zaimportuj kolekcję lub bibliotekę Steam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Steam não retornou suas inscrições. Importe uma coleção ou uma biblioteca Steam em vez disso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam не вернул ваши подписки. Импортируйте коллекцию или библиотеку Steam."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam aboneliklerinizi döndürmedi. Bunun yerine bir koleksiyon ya da Steam kütüphanesi içe aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam не повернув ваші підписки. Натомість імпортуйте колекцію або бібліотеку Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
