    "Playback speed of the soundtrack. Link it to the video speed to keep them in step." : {
      "comment" : "Details panel tooltip",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabegeschwindigkeit des Soundtracks. Verknüpfen Sie sie mit der Videogeschwindigkeit, damit beide synchron bleiben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse de lecture de la bande-son. Liez-la à la vitesse de la vidéo pour les garder synchronisées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad de reproducción de la banda sonora. Vincúlala a la velocidad del vídeo para mantenerlos sincronizados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
