    "Assign a different wallpaper to each screen, or mirror one across all of them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عيّن خلفية مختلفة لكل شاشة، أو اعرض خلفية واحدة على جميع الشاشات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weisen Sie jedem Bildschirm ein eigenes Hintergrundbild zu oder spiegeln Sie eines auf alle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigna un fondo de pantalla distinto a cada pantalla o duplica uno en todas ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attribuez un fond d’écran différent à chaque écran, ou affichez le même sur tous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर स्क्रीन को अलग वॉलपेपर असाइन करें, या एक ही वॉलपेपर सभी स्क्रीन पर मिरर करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assegna uno sfondo diverso a ogni schermo o duplicane uno su tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面ごとに異なる壁紙を割り当てることも、1つの壁紙をすべての画面にミラーリングすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면마다 다른 배경화면을 지정하거나 하나의 배경화면을 모든 화면에 미러링할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypisz inną tapetę do każdego ekranu lub powiel jedną na wszystkich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
