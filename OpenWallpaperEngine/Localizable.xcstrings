    "Draws bars that rise and fall with the audio you are hearing. Needs Screen & System Audio Recording permission." : {
      "comment" : "Scene Inspector tooltip for the audiobars effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet Balken, die mit dem gerade hörbaren Audio steigen und fallen. Erfordert die Berechtigung „Aufnahme von Bildschirm & Systemaudio“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessine des barres qui montent et descendent au rythme du son que vous entendez. Nécessite l’autorisation « Enregistrement de l’écran et des sons du système »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja barras que suben y bajan con el audio que estás escuchando. Requiere el permiso de Grabación de pantalla y del audio del sistema."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha barras que sobem e descem com o áudio que você está ouvindo. Requer a permissão de Gravação do Áudio do Sistema e da Tela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna barre che salgono e scendono con l’audio che stai ascoltando. Richiede l’autorizzazione Registrazione schermo e audio di sistema."
          }
        }
      }
    },
