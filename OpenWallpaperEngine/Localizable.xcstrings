    "Makes colours richer on loud passages. %@" : {
      "comment" : "%@ is the music sync explanation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht Farben bei lauten Passagen satter. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend les couleurs plus riches lors des passages forts. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensifica los colores en los pasajes fuertes. %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa as cores mais intensas nos trechos altos. %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rende i colori più intensi nei passaggi ad alto volume. %@"
          }
        }
      }
    },
    "Makes one colour transparent, like a green screen. Raise Tolerance until the colour disappears, then raise Fuzziness to soften the edge." : {
      "comment" : "Scene Inspector tooltip for the colorkey effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht eine Farbe transparent, wie bei einem Greenscreen. Erhöhen Sie „Toleranz“, bis die Farbe verschwindet, und dann „Unschärfe“, um die Kante weicher zu machen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend une couleur transparente, comme un fond vert. Augmentez « Tolérance » jusqu’à ce que la couleur disparaisse, puis augmentez « Adoucissement » pour adoucir le contour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve transparente un color, como una pantalla verde. Sube Tolerancia hasta que desaparezca el color y después sube Difuminación para suavizar el borde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna uma cor transparente, como um chroma key. Aumente a Tolerância até a cor desaparecer e depois aumente a Suavidade para suavizar a borda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rende trasparente un colore, come un green screen. Alza Tolleranza finché il colore non scompare, poi alza Sfumatura per ammorbidire il bordo."
          }
        }
      }
    },
