        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा प्रॉपर्टी और सीन इंस्पेक्टर के बदलाव सहेजता है। इसी नाम का प्रीसेट बदल दिया जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
