    "Rocks the layer back and forth around its base." : {
      "comment" : "Scene Inspector tooltip for the swing effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaukelt die Ebene um ihre Basis hin und her."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balance le calque d’avant en arrière autour de sa base."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balancea la capa adelante y atrás en torno a su base."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balança a camada para a frente e para trás em torno da base."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa oscillare il livello avanti e indietro attorno alla sua base."
          }
