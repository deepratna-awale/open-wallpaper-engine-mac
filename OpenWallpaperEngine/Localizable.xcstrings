    "Simulated camera exposure. Positive brightens, negative darkens." : {
      "comment" : "Scene Inspector tooltip for an effect parameter named like exposure",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محاكاة لتعريض الكاميرا. القيم الموجبة تزيد السطوع، والسالبة تعتّم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulierte Kamerabelichtung. Positive Werte hellen auf, negative dunkeln ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exposición de cámara simulada. Los valores positivos aclaran; los negativos oscurecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exposition simulée de l’appareil photo. Une valeur positive éclaircit, une valeur négative assombrit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैमरे के एक्सपोज़र का सिमुलेशन. धनात्मक मान रोशनी बढ़ाते हैं, ऋणात्मक मान गहरा करते हैं."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esposizione simulata della fotocamera. I valori positivi schiariscono, quelli negativi scuriscono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラの露出をシミュレートします。正の値で明るく、負の値で暗くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 노출을 시뮬레이션합니다. 양수이면 밝아지고, 음수이면 어두워집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symulowana ekspozycja aparatu. Wartości dodatnie rozjaśniają, ujemne przyciemniają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exposição de câmera simulada. Valores positivos clareiam; negativos escurecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имитация экспозиции камеры. Положительные значения осветляют, отрицательные затемняют."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benzetilmiş kamera pozlaması. Pozitif değerler aydınlatır, negatif değerler karartır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імітована експозиція камери. Додатні значення освітлюють, відʼємні — затемнюють."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模拟相机曝光。正值变亮，负值变暗。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模擬相機曝光。正值變亮，負值變暗。"
          }
        }
      }
    },
