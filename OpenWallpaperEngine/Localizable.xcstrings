    "Sharpens local detail without changing overall brightness. High values look crunchy." : {
      "comment" : "Scene Inspector tooltip for the localcontrast effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schärft lokale Details, ohne die Gesamthelligkeit zu ändern. Hohe Werte wirken überschärft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accentue les détails locaux sans modifier la luminosité globale. Les valeurs élevées donnent un aspect trop dur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realza el detalle local sin cambiar el brillo general. Los valores altos quedan demasiado duros."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta a nitidez dos detalhes locais sem alterar o brilho geral. Valores altos ficam ásperos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rende più nitidi i dettagli locali senza cambiare la luminosità complessiva. Valori alti risultano eccessivi."
          }
        }
      }
    },
    "Sharpness of the wave crests. 1 is a smooth sine; higher values give peaked, choppier water." : {
      "comment" : "Scene Inspector tooltip for the waterwaves effect's exponent parameter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schärfe der Wellenkämme. 1 ist eine weiche Sinuswelle; höhere Werte ergeben spitzeres, unruhigeres Wasser."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netteté des crêtes des vagues. 1 donne une sinusoïde douce ; les valeurs plus élevées donnent une eau plus pointue et agitée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nitidez de las crestas de las olas. 1 es una senoide suave; los valores más altos dan un agua más picada y con crestas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nitidez das cristas das ondas. 1 é uma senoide suave; valores mais altos geram água mais pontiaguda e agitada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nitidezza delle creste delle onde. 1 è una sinusoide morbida; valori più alti danno un’acqua più appuntita e agitata."
          }
        }
      }
    },
