    "Lowest audio frequency band that drives this. Raise it to ignore bass." : {
      "comment" : "Scene Inspector tooltip for an effect parameter named like frequencymin",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدنى نطاق ترددات صوتية يتحكم في هذه القيمة. ارفعه لتجاهل الجهير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedrigstes Audiofrequenzband, das diesen Wert steuert. Erhöhen Sie es, um Bässe zu ignorieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banda de frecuencia de audio más baja que lo controla. Súbela para ignorar los graves."
          }
        },
        "fr" : {
