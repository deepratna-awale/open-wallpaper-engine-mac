    "Queued. Downloads continue in the background; see the Downloads tab." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في قائمة الانتظار. تستمر التنزيلات في الخلفية؛ راجع علامة تبويب التنزيلات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Warteschlange. Downloads laufen im Hintergrund weiter; siehe Tab „Downloads“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cola. Las descargas continúan en segundo plano; consulta la pestaña Descargas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente. Les téléchargements continuent en arrière-plan ; voir l’onglet Téléchargements."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कतार में है। डाउनलोड बैकग्राउंड में जारी रहते हैं; डाउनलोड टैब देखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In coda. I download continuano in background; vedi la scheda Download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待機中です。ダウンロードはバックグラウンドで続きます。「ダウンロード」タブを参照してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기 중입니다. 다운로드는 백그라운드에서 계속되며 다운로드 탭에서 확인할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W kolejce. Pobieranie trwa w tle; zobacz kartę Pobrane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na fila. Os downloads continuam em segundo plano; veja a aba Downloads."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В очереди. Загрузки продолжаются в фоне; см. вкладку «Загрузки»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırada. İndirmeler arka planda sürer; İndirilenler sekmesine bakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У черзі. Викачування триває у фоні; див. вкладку «Викачування»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
