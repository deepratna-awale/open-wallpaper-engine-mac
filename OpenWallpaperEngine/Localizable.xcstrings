    "Bulges the image outward from a centre point like a fisheye lens." : {
      "comment" : "Scene Inspector tooltip for the fisheye effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينفخ الصورة نحو الخارج من نقطة مركزية مثل عدسة عين السمكة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wölbt das Bild von einem Mittelpunkt nach außen wie ein Fischaugenobjektiv."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abomba la imagen hacia fuera desde un punto central, como un objetivo ojo de pez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bombe l’image vers l’extérieur à partir d’un point central, comme un objectif fisheye."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़िशआई लेंस की तरह इमेज को केंद्र बिंदु से बाहर की ओर उभारता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gonfia l’immagine verso l’esterno da un punto centrale, come un obiettivo fisheye."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "魚眼レンズのように、中心点から外側へ画像を膨らませます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어안 렌즈처럼 중심점에서 이미지를 바깥쪽으로 부풀립니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrzusza obraz na zewnątrz od punktu centralnego jak obiektyw typu rybie oko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estufa a imagem para fora a partir de um ponto central, como uma lente olho de peixe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выпячивает изображение от центральной точки, как объектив «рыбий глаз»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntüyü balık gözü mercek gibi bir merkez noktasından dışa doğru şişirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Випинає зображення назовні від центральної точки, як обʼєктив «рибʼяче око»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像鱼眼镜头一样使图像从中心点向外凸起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓影像從中心點向外凸出，如同魚眼鏡頭。"
          }
        }
      }
    },
