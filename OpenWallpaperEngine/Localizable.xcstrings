    "WE shaders are translated per combination of options the first time a scene uses them, then reused." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WE-Shader werden für jede Kombination von Optionen übersetzt, wenn eine Szene sie zum ersten Mal verwendet, und dann wiederverwendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nuanceurs WE sont traduits pour chaque combinaison d’options la première fois qu’une scène les utilise, puis réutilisés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sombreadores de WE se traducen para cada combinación de opciones la primera vez que una escena los usa, y después se reutilizan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os shaders do WE são traduzidos para cada combinação de opções na primeira vez que uma cena os usa e, depois, reutilizados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli shader di WE vengono tradotti per ogni combinazione di opzioni la prima volta che una scena li usa, poi vengono riutilizzati."
          }
        }
      }
    },
    "Wallpaper Engine for Mac" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine for Mac"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine für Mac"
          }
        },
        "fr" : {
          "stringUnit" : {
