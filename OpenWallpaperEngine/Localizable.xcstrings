    "High FPS may slow down your Mac!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يؤدي معدل الإطارات المرتفع إلى إبطاء جهاز Mac!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine hohe Bildrate kann Ihren Mac verlangsamen!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Unos FPS altos pueden ralentizar tu Mac!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fréquence d’images élevée peut ralentir votre Mac !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उच्च FPS से आपका Mac धीमा हो सकता है!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un valore alto di FPS può rallentare il Mac!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FPSを高くするとMacの動作が遅くなる可能性があります！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FPS가 높으면 Mac이 느려질 수 있습니다!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysoka liczba klatek może spowolnić Twojego Maca!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FPS alto pode deixar o Mac lento!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высокая частота кадров может замедлить ваш Mac!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek FPS Mac’inizi yavaşlatabilir!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Висока частота кадрів може сповільнити ваш Mac!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高帧速率可能会降低 Mac 的运行速度！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高 FPS 可能會降低 Mac 速度！"
          }
        }
      }
    },
    "High FPS may slow down your Mac! We're serious, this is too much 🔥." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يؤدي معدل الإطارات المرتفع إلى إبطاء جهاز Mac! نحن جادّون، هذا كثير جدًا 🔥."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine hohe Bildrate kann Ihren Mac verlangsamen! Im Ernst, das ist zu viel 🔥."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Unos FPS altos pueden ralentizar tu Mac! Va en serio, esto es demasiado 🔥."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fréquence d’images élevée peut ralentir votre Mac ! Sérieusement, c’est beaucoup trop 🔥."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उच्च FPS से आपका Mac धीमा हो सकता है! हम सच कह रहे हैं, यह बहुत ज़्यादा है 🔥."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un valore alto di FPS può rallentare il Mac! Non scherziamo, è davvero troppo 🔥."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FPSを高くするとMacの動作が遅くなる可能性があります！本当に、これは高すぎます🔥。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FPS가 높으면 Mac이 느려질 수 있습니다! 진심입니다, 이건 너무 높아요 🔥."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysoka liczba klatek może spowolnić Twojego Maca! Serio, to już przesada 🔥."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FPS alto pode deixar o Mac lento! É sério, isso é demais 🔥."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высокая частота кадров может замедлить ваш Mac! Серьёзно, это слишком 🔥."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek FPS Mac’inizi yavaşlatabilir! Ciddiyiz, bu çok fazla 🔥."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Висока частота кадрів може сповільнити ваш Mac! Без жартів, це забагато 🔥."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高帧速率可能会降低 Mac 的运行速度！这可不是开玩笑，设置得太高了🔥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高 FPS 可能會降低 Mac 速度！說真的，這太過頭了 🔥。"
          }
        }
      }
    },
