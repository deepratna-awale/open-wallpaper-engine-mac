    "Moves the layer against the pointer so it appears to sit at a different depth." : {
      "comment" : "Scene Inspector tooltip for the parallax effect",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt die Ebene gegen den Zeiger, sodass sie in einer anderen Tiefe zu liegen scheint."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace le calque à l’opposé du pointeur pour qu’il semble situé à une autre profondeur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve la capa en sentido contrario al puntero para que parezca estar a otra profundidad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move a camada em sentido oposto ao ponteiro para que pareça estar em outra profundidade."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta il livello in direzione opposta al puntatore, così sembra trovarsi a una profondità diversa."
          }
        }
      }
    },
    "Moving into Wallpaper Storage…" : {
