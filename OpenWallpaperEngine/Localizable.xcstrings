    "Midtone brightness curve. 1 leaves the layer unchanged." : {
      "comment" : "Scene Inspector tooltip for an effect parameter named like gamma",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منحنى سطوع الدرجات المتوسطة. 1 يترك الطبقة دون تغيير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helligkeitskurve der Mitteltöne. 1 lässt die Ebene unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curva de brillo de los tonos medios. 1 deja la capa sin cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Courbe de luminosité des tons moyens. 1 laisse le calque inchangé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिडटोन ब्राइटनेस कर्व. 1 लेयर को अपरिवर्तित छोड़ता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curva di luminosità dei mezzitoni. 1 lascia invariato il livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中間調の明るさカーブです。1ではレイヤーは変化しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중간 톤 밝기 곡선입니다. 1이면 레이어가 그대로 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krzywa jasności półtonów. 1 pozostawia warstwę bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curva de brilho dos tons médios. 1 deixa a camada inalterada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кривая яркости средних тонов. 1 оставляет слой без изменений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orta ton parlaklık eğrisi. 1 katmanı değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крива яскравості середніх тонів. 1 залишає шар незмінним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中间调亮度曲线。1 表示图层保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中間調亮度曲線。1 維持圖層不變。"
          }
        }
      }
    },
    "Mirrors the layer below itself, as if on water or glass." : {
      "comment" : "Scene Inspector tooltip for the reflection effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعكس الطبقة أسفلها، كما لو كانت على ماء أو زجاج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiegelt die Ebene unter sich, wie auf Wasser oder Glas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refleja la capa debajo de sí misma, como sobre agua o cristal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflète le calque sous lui-même, comme sur de l’eau ou du verre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेयर को अपने नीचे मिरर करता है, मानो पानी या काँच पर हो."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riflette il livello sotto sé stesso, come sull’acqua o sul vetro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水面やガラスに映ったように、レイヤーを下側に反転して映します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물이나 유리 위에 있는 것처럼 레이어를 아래쪽에 반사합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odbija warstwę pod nią samą, jak na wodzie lub szkle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espelha a camada abaixo de si mesma, como se estivesse sobre água ou vidro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
