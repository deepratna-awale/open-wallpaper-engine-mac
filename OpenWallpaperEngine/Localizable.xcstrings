    "Downloads the assets from Steam again even when they're up to date, to repair a damaged copy." : {
      "comment" : "Help tag of the Re-download button in Settings › Assets",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنزّل الأصول من Steam مجددًا حتى إن كانت محدَّثة، لإصلاح نسخة تالفة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt die Assets erneut von Steam, auch wenn sie aktuell sind, um eine beschädigte Kopie zu reparieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a descargar los recursos de Steam aunque estén actualizados, para reparar una copia dañada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge à nouveau les ressources depuis Steam même si elles sont à jour, pour réparer une copie endommagée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्षतिग्रस्त कॉपी ठीक करने के लिए, एसेट अप टू डेट होने पर भी उन्हें Steam से फिर से डाउनलोड करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica di nuovo le risorse da Steam anche se sono aggiornate, per riparare una copia danneggiata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新の場合でも Steam からアセットを再ダウンロードし、破損したコピーを修復します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에셋이 최신 상태여도 Steam에서 다시 다운로드하여 손상된 사본을 복구합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobiera zasoby ze Steam ponownie, nawet jeśli są aktualne, aby naprawić uszkodzoną kopię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa os recursos do Steam novamente, mesmo que estejam atualizados, para reparar uma cópia danificada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружает ресурсы из Steam заново, даже если они актуальны, чтобы восстановить повреждённую копию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bozuk bir kopyayı onarmak için varlıkları güncel olsalar bile Steam’den yeniden indirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Викачує ресурси зі Steam знову, навіть якщо вони актуальні, щоб виправити пошкоджену копію."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使资源已是最新，也从 Steam 重新下载，以修复损坏的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使資源已是最新，也從 Steam 重新下載，以修復損毀的副本。"
          }
        }
      }
