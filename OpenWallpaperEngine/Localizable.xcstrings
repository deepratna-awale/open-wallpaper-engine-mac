          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densidade de falhas e pontos de ruído."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densità di dropout e puntini di rumore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドロップアウトやノイズの斑点の密度です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드롭아웃과 노이즈 반점의 밀도입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
