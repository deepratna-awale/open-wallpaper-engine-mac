    "Copy the wallpapers of Wallpaper Engine on Windows, in a CrossOver bottle or on a Boot Camp disk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انسخ خلفيات Wallpaper Engine من Windows أو من زجاجة CrossOver أو من قرص Boot Camp."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren Sie die Hintergrundbilder von Wallpaper Engine unter Windows, in einer CrossOver-Flasche oder auf einem Boot Camp-Volume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia los fondos de pantalla de Wallpaper Engine en Windows, en una botella de CrossOver o en un disco de Boot Camp."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez les fonds d’écran de Wallpaper Engine sous Windows, dans une bouteille CrossOver ou sur un disque Boot Camp."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows, CrossOver बॉटल या Boot Camp डिस्क पर मौजूद Wallpaper Engine के वॉलपेपर कॉपी करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia gli sfondi di Wallpaper Engine su Windows, in una bottiglia CrossOver o su un disco Boot Camp."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows、CrossOver のボトル、または Boot Camp ディスク上の Wallpaper Engine の壁紙をコピーします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows, CrossOver 보틀 또는 Boot Camp 디스크에 있는 Wallpaper Engine의 배경화면을 복사합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skopiuj tapety Wallpaper Engine z systemu Windows, butelki CrossOver lub dysku Boot Camp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie as imagens de fundo do Wallpaper Engine no Windows, em uma garrafa do CrossOver ou em um disco do Boot Camp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопируйте обои Wallpaper Engine из Windows, бутылки CrossOver или диска Boot Camp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows’taki, bir CrossOver şişesindeki ya da bir Boot Camp diskindeki Wallpaper Engine duvar kâğıtlarını kopyalayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопіюйте шпалери Wallpaper Engine з Windows, пляшки CrossOver або диска Boot Camp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷贝 Windows、CrossOver 容器或启动转换磁盘上 Wallpaper Engine 的墙纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷貝 Windows、CrossOver 容器或 Boot Camp 磁碟上 Wallpaper Engine 的背景圖片。"
          }
        }
      }
    },
