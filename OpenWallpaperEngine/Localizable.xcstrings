          }
        }
      }
    },
    "Native draws at the display's full pixel count. Desktop draws one pixel per point (half the width and height on a Retina display) and scales the frame up, for a quarter of the work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nativ“ zeichnet mit der vollen Pixelanzahl des Displays. „Schreibtisch“ zeichnet ein Pixel pro Punkt (halbe Breite und Höhe auf einem Retina-Display) und skaliert das Bild hoch – bei einem Viertel des Aufwands."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Native » dessine avec tous les pixels du moniteur. « Bureau » dessine un pixel par point (la moitié de la largeur et de la hauteur sur un écran Retina) puis agrandit l’image, pour un quart du travail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nativa dibuja con todos los píxeles de la pantalla. Escritorio dibuja un píxel por punto (la mitad de ancho y de alto en una pantalla Retina) y amplía el fotograma, con una cuarta parte del trabajo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nativa desenha com a contagem total de pixels da tela. Mesa desenha um pixel por ponto (metade da largura e da altura em uma tela Retina) e amplia o quadro, com um quarto do trabalho."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Nativa” disegna con tutti i pixel dello schermo. “Scrivania” disegna un pixel per punto (metà larghezza e metà altezza su uno schermo Retina) e ingrandisce il fotogramma, con un quarto del lavoro."
          }
        }
      }
    },
    "Nature" : {
      "comment" : "Workshop genre tag",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natur"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nature"
