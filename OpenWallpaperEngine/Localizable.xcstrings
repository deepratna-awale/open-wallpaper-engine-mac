    "Height of the torn band. Small values give a thin tracking line, large values disturb most of the frame." : {
      "comment" : "Scene Inspector tooltip for the vhs effect's distortionwidth parameter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارتفاع الشريط الممزق. تعطي القيم الصغيرة خط تتبع رفيعًا، بينما تُربك القيم الكبيرة معظم الإطار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhe des gestörten Streifens. Kleine Werte ergeben eine dünne Tracking-Linie, große Werte stören den Großteil des Bildes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura de la franja rasgada. Los valores bajos crean una línea de tracking fina; los altos alteran casi todo el fotograma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauteur de la bande déchirée. Les petites valeurs donnent une fine ligne de tracking, les grandes perturbent la majeure partie de l’image."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फटी हुई पट्टी की ऊँचाई. छोटे मान पतली ट्रैकिंग लाइन देते हैं, बड़े मान फ़्रेम के ज़्यादातर हिस्से को बिगाड़ देते हैं."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altezza della banda strappata. Valori bassi danno una sottile linea di tracking, valori alti disturbano gran parte del fotogramma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "乱れる帯の高さです。小さい値では細いトラッキングラインになり、大きい値ではフレームの大部分が乱れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "찢어지는 띠의 높이입니다. 값이 작으면 얇은 트래킹 선이 생기고, 값이 크면 프레임 대부분이 흐트러집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysokość rozdartego pasa. Małe wartości dają cienką linię zakłóceń, duże zaburzają większość klatki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura da faixa rasgada. Valores pequenos geram uma linha fina de tracking; valores grandes perturbam a maior parte do quadro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высота разорванной полосы. Малые значения дают тонкую линию трекинга, большие искажают почти весь кадр."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yırtık bandın yüksekliği. Küçük değerler ince bir izleme çizgisi verir, büyük değerler karenin çoğunu bozar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Висота розірваної смуги. Малі значення дають тонку лінію трекінгу, великі — спотворюють більшу частину кадру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撕裂带的高度。数值小时为一条细的跟踪线，数值大时会干扰大部分画面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撕裂帶的高度。數值小時為細細的循軌線，數值大時會干擾大部分畫面。"
          }
        }
      }
    },
    "Height of the waves — how far pixels are displaced." : {
      "comment" : "Scene Inspector tooltip for the waterwaves effect's strength parameter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارتفاع الأمواج — أي مدى إزاحة وحدات البكسل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhe der Wellen – wie weit Pixel verschoben werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura de las olas: cuánto se desplazan los píxeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauteur des vagues — distance de déplacement des pixels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लहरों की ऊँचाई — पिक्सेल कितनी दूर खिसकते हैं."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altezza delle onde, ovvero quanto vengono spostati i pixel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "波の高さ — ピクセルがずれる距離です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파도의 높이, 즉 픽셀이 변위되는 거리입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysokość fal — jak daleko przesuwane są piksele."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura das ondas — o quanto os pixels são deslocados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высота волн — насколько смещаются пиксели."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalgaların yüksekliği — piksellerin ne kadar kaydırıldığı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Висота хвиль — наскільки далеко зміщуються пікселі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "波浪的高度——像素的位移距离。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "波浪的高度——像素的位移距離。"
          }
        }
      }
    },
    "Height the bars keep in silence, so they do not vanish between beats." : {
      "comment" : "Scene Inspector tooltip for the audiobars effect's minimum parameter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الارتفاع الذي تحافظ عليه الأشرطة في أثناء الصمت، كي لا تختفي بين الإيقاعات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhe, die die Balken bei Stille behalten, damit sie zwischen den Beats nicht verschwinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura que mantienen las barras en silencio, para que no desaparezcan entre golpes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauteur conservée par les barres pendant les silences, pour qu’elles ne disparaissent pas entre les temps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुप्पी में बार कितनी ऊँचाई बनाए रखते हैं, ताकि वे बीट्स के बीच गायब न हों."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altezza che le barre mantengono nel silenzio, così non spariscono tra un battito e l’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無音時にバーが保つ高さです。ビートの合間にバーが消えないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소리가 없을 때 막대가 유지하는 높이로, 비트 사이에 막대가 사라지지 않게 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysokość słupków w ciszy, aby nie znikały między uderzeniami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura que as barras mantêm no silêncio, para não sumirem entre as batidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высота полос в тишине, чтобы они не исчезали между долями."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çubukların sessizlikte koruduğu yükseklik; böylece vuruşlar arasında kaybolmazlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Висота, яку смуги зберігають у тиші, щоб не зникати між ударами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静音时条形保持的高度，使其在节拍之间不会消失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無聲時長條保持的高度，讓長條不會在節拍之間消失。"
          }
        }
      }
    },
