        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rengin, yıpranmış bant gibi yana doğru ne kadar taştığı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наскільки далеко колір розтікається вбік, як на зношеній плівці."
