        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt einen hellen Streifen über die Ebene. Die Maske bestimmt, welche Teile das Licht einfangen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa una franja brillante por la capa. La máscara controla qué partes pueden recibir la luz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait passer une bande lumineuse sur le calque. Le masque détermine les parties qui peuvent capter la lumière."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेयर पर एक चमकीली पट्टी घुमाता है. मास्क तय करता है कि कौन-से हिस्से रोशनी पकड़ सकते हैं."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa scorrere una banda luminosa sul livello. La maschera stabilisce quali parti possono catturare la luce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明るい帯をレイヤー全体に走らせます。マスクで光が当たる部分を制御します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이어를 가로질러 밝은 띠를 쓸고 지나갑니다. 마스크로 빛을 받을 부분을 제어합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwa jasny pas po warstwie. Maska określa, które części mogą złapać światło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa uma faixa brilhante pela camada. A máscara controla quais partes podem receber a luz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проводит яркую полосу по слою. Маска определяет, какие части могут бликовать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katman boyunca parlak bir şerit gezdirir. Maske, hangi bölümlerin ışığı yakalayabileceğini belirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проводить яскраву смугу по шару. Маска визначає, які частини можуть відбивати світло."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让一道亮带扫过图层。蒙版控制哪些部分会被照亮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓一道亮帶掃過圖層。遮罩控制哪些部分會被照亮。"
          }
        }
      }
    },
