            "state" : "translated",
            "value" : "Pega el enlace de una colección del Workshop o su número."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez le lien d’une collection du Workshop ou son numéro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workshop कलेक्शन का लिंक या उसका नंबर पेस्ट करें।"
          }
        },
        "it" : {
