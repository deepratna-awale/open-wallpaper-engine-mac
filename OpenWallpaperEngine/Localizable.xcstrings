    "A few steps to set things up. Skip any of them and come back later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بضع خطوات للإعداد. يمكنك تخطي أي منها والعودة لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
