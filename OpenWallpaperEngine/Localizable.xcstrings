    "Play scene, video, web and image wallpapers, with a familiar layout if you already know Wallpaper Engine." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie Szenen-, Video-, Web- und Bild-Hintergrundbilder wieder – mit einem vertrauten Layout, wenn Sie Wallpaper Engine bereits kennen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez des fonds d’écran de type scène, vidéo, web et image, avec une présentation familière si vous connaissez déjà Wallpaper Engine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce fondos de pantalla de escena, vídeo, web e imagen, con una disposición familiar si ya conoces Wallpaper Engine."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduza imagens de fundo de cena, vídeo, web e imagem, com um layout familiar se você já conhece o Wallpaper Engine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduci sfondi di tipo scena, video, web e immagine, con un layout familiare se conosci già Wallpaper Engine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーン、ビデオ、Web、画像の壁紙を再生できます。Wallpaper Engineをご存じなら、見慣れたレイアウトで使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면, 비디오, 웹 및 이미지 배경화면을 재생하며, Wallpaper Engine을 이미 사용해 봤다면 익숙한 레이아웃으로 사용할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放场景、视频、网页和图像墙纸。如果你熟悉 Wallpaper Engine，布局也会很熟悉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放場景、影片、網頁和影像背景圖片；如果你熟悉 Wallpaper Engine，也會覺得版面似曾相識。"
          }
        }
      }
    },
