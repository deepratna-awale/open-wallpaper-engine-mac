          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면 렌더링, 창작마당, 다중 디스플레이"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
