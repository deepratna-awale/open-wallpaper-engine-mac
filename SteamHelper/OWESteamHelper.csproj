<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app's Steam helper (README.md): sign-in, Workshop queries and downloads over Steam's
       client protocol. Builds DepotDownloader's sources (Vendor/DepotDownloader) into the same
       executable and pins the same packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>owe-steam-helper</AssemblyName>
    <RootNamespace>OWESteamHelper</RootNamespace>
    <StartupObject>OWESteamHelper.Entry</StartupObject>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Compile Include="../Vendor/DepotDownloader/DepotDownloader/*.cs" Link="DepotDownloader/%(Filename)%(Extension)" />
    <AdditionalFiles Include="../Vendor/DepotDownloader/DepotDownloader/NativeMethods.txt" />
    <InternalsVisibleTo Include="OWESteamHelper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="protobuf-net" Version="3.4.30" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SteamKit2" Version="3.5.0" />
  </ItemGroup>
</Project>
