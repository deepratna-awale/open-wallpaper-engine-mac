<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- .NET compiles the helper's code at run time (MAP_JIT). Nothing else is relaxed: the helper
	     is one self-contained file and loads no library of its own. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
