    "The preview can’t evaluate this expression and always shows the property." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن للمعاينة تقييم هذا التعبير، لذا تعرض الخاصية دائمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vorschau kann diesen Ausdruck nicht auswerten und zeigt die Eigenschaft immer an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La previsualización no puede evaluar esta expresión y siempre muestra la propiedad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aperçu ne peut pas évaluer cette expression et affiche toujours la propriété."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रीव्यू इस एक्सप्रेशन का मूल्यांकन नहीं कर सकता और प्रॉपर्टी हमेशा दिखाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’anteprima non può valutare questa espressione e mostra sempre la proprietà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューではこの式を評価できないため、プロパティは常に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리보기에서 이 식을 평가할 수 없어 속성이 항상 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgląd nie może obliczyć tego wyrażenia i zawsze pokazuje właściwość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pré-visualização não consegue avaliar esta expressão e sempre mostra a propriedade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предварительный просмотр не может вычислить это выражение и всегда показывает свойство."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önizleme bu ifadeyi değerlendiremez ve özelliği her zaman gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попередній перегляд не може обчислити цей вираз і завжди показує властивість."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
