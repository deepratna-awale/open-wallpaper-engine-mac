    "Hide this layer; “%@” sets it again when you show it" : {
      "comment" : "Layer list: help of the eye of a layer a user property shows; hiding it overrides the property, showing it hands it back. %@ is the property's key",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء هذه الطبقة؛ تحددها خاصية المستخدم ”%@“ مجددًا عند إظهارها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ebene ausblenden; „%@“ legt sie wieder fest, wenn Sie sie einblenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar esta capa; «%@» la vuelve a definir cuando la muestre"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer ce calque ; « %@ » le définit à nouveau quand vous l’affichez"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह लेयर छिपाएँ; दिखाने पर “%@” इसे फिर से सेट करेगी"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi questo livello; “%@” lo imposta di nuovo quando lo mostri"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このレイヤーを非表示にします。表示に戻すと「%@」で再び設定されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 레이어 가리기. 다시 보면 ‘%@’에서 다시 설정됨"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryj tę warstwę; „%@” ustawi ją znowu, gdy ją pokażesz"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar esta camada; “%@” volta a defini-la quando você a mostrar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрыть этот слой; когда вы покажете его, его снова задаст «%@»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu katmanı gizle; gösterdiğinizde “%@” onu yeniden belirler"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховати цей шар; коли ви його покажете, його знову задаватиме «%@»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
