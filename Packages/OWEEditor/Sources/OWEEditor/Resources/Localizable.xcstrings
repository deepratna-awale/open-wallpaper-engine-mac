    "Show this layer; “%@” sets it again" : {
      "comment" : "Layer list: help of the eye of a layer hidden over the user property that shows it; showing it hands it back to the property. %@ is the property's key",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار هذه الطبقة؛ تحددها خاصية المستخدم ”%@“ مجددًا"
