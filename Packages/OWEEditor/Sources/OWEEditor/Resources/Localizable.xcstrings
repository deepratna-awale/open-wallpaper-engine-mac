    "Add one with + to let users change the wallpaper: bind it to a layer’s field from the inspector." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف خاصية باستخدام + ليتمكن المستخدمون من تغيير الخلفية، ثم اربطها بحقل طبقة من المراقب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie mit + eine hinzu, damit Benutzer das Hintergrundbild ändern können, und verknüpfen Sie sie im Inspektor mit dem Feld einer Ebene."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una con + para que los usuarios cambien el fondo de pantalla y vincúlala al campo de una capa desde el inspector."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez-en une avec + pour que l’utilisateur puisse modifier le fond d’écran, puis liez-la au champ d’un calque dans l’inspecteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+ से एक प्रॉपर्टी जोड़ें ताकि यूज़र वॉलपेपर बदल सकें, फिर इंस्पेक्टर से उसे किसी लेयर के फ़ील्ड से बाइंड करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungine una con + per permettere agli utenti di modificare lo sfondo, poi collegala al campo di un livello dall’Inspector."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「+」で追加すると、ユーザが壁紙を変更できるようになります。インスペクタでレイヤーのフィールドにバインドしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+로 추가하면 사용자가 배경화면을 변경할 수 있습니다. 인스펙터에서 레이어의 필드에 연결하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj właściwość przyciskiem +, aby użytkownicy mogli zmieniać tapetę, i powiąż ją z polem warstwy w inspektorze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma com + para que os usuários alterem a imagem de fundo e vincule-a ao campo de uma camada no inspetor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте свойство кнопкой +, чтобы пользователи могли менять обои, и привяжите его к полю слоя в инспекторе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcıların duvar kâğıdını değiştirebilmesi için + ile bir özellik ekleyin ve denetçiden bir katmanın alanına bağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте властивість кнопкою +, щоб користувачі могли змінювати шпалеру, і привʼяжіть її до поля шару в інспекторі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 + 添加一个属性，让用户可以更改墙纸，然后在检查器中将其绑定到图层的字段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 + 加入屬性，讓使用者可以更改背景圖片，然後在檢閱器中將其綁定到圖層的欄位。"
          }
        }
      }
    },
