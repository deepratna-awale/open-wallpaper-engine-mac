          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ebene einblenden; „%@“ legt sie wieder fest"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar esta capa; «%@» la vuelve a definir"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher ce calque ; « %@ » le définit à nouveau"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह लेयर दिखाएँ; “%@” इसे फिर से सेट करेगी"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra questo livello; “%@” lo imposta di nuovo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このレイヤーを表示します。再び「%@」で設定されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 레이어 보기. ‘%@’에서 다시 설정됨"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż tę warstwę; „%@” znowu ją ustawia"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar esta camada; “%@” volta a defini-la"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
