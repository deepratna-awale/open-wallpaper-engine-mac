    "As the user sees the properties: try a value to see the conditions at work." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخصائص كما يراها المستخدم: جرّب قيمة لترى الشروط وهي تعمل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sieht der Benutzer die Eigenschaften: Probieren Sie einen Wert aus, um die Bedingungen in Aktion zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las propiedades tal como las ve el usuario: prueba un valor para ver las condiciones en acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les propriétés telles que l’utilisateur les voit : essayez une valeur pour voir les conditions à l’œuvre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यूज़र को प्रॉपर्टी ऐसी दिखती हैं: कंडीशन को काम करते देखने के लिए कोई वैल्यू आज़माएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le proprietà come le vede l’utente: prova un valore per vedere le condizioni all’opera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザに表示されるプロパティです。値を変えて条件の動作を確認できます。"
