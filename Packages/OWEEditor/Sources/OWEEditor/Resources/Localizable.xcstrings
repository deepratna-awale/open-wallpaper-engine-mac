    "A copy of the wallpaper with your edits is added to the library. The original stays as it is." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُضاف نسخة من الخلفية مع تعديلاتك إلى المكتبة، ويبقى الأصل كما هو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kopie des Hintergrundbilds mit Ihren Änderungen wird zur Mediathek hinzugefügt. Das Original bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añade a la biblioteca una copia del fondo de pantalla con tus cambios. El original no se modifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une copie du fond d’écran avec vos modifications est ajoutée à la bibliothèque. L’original reste tel quel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके बदलावों वाली वॉलपेपर की एक कॉपी लाइब्रेरी में जोड़ी जाती है। मूल वैसा ही रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia dello sfondo con le tue modifiche viene aggiunta alla libreria. L’originale resta invariato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集を反映した壁紙のコピーがライブラリに追加されます。元の壁紙はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집 내용이 적용된 배경화면 사본이 라이브러리에 추가됩니다. 원본은 그대로 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia tapety z Twoimi zmianami zostanie dodana do biblioteki. Oryginał pozostanie bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma cópia da imagem de fundo com suas alterações é adicionada à biblioteca. O original continua como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия обоев с вашими изменениями добавляется в библиотеку. Оригинал остаётся без изменений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenlemelerinizi içeren duvar kâğıdının bir kopyası kütüphaneye eklenir. Orijinali olduğu gibi kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копію шпалери з вашими змінами буде додано до бібліотеки. Оригінал залишиться без змін."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带有你所做编辑的墙纸副本会添加到资料库。原墙纸保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含有你所做編輯的背景圖片拷貝會加入資料庫。原始背景圖片保持不變。"
          }
        }
      }
    },
    "A script or animation changes this value; the edit sets where it starts." : {
      "comment" : "Wallpaper Editor",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغيّر برنامج نصي أو رسم متحرك هذه القيمة؛ يحدد التعديل نقطة بدايتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Skript oder eine Animation ändert diesen Wert; die Änderung legt seinen Startwert fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un script o una animación cambia este valor; la edición define dónde empieza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un script ou une animation modifie cette valeur ; la modification définit sa valeur de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस मान को कोई स्क्रिप्ट या ऐनिमेशन बदलता है; संपादन उसका शुरुआती मान तय करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno script o un’animazione cambia questo valore; la modifica ne imposta il punto di partenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリプトまたはアニメーションがこの値を変更します。編集は開始値を設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크립트나 애니메이션이 이 값을 바꿉니다. 편집하면 시작 값이 설정됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tę wartość zmienia skrypt lub animacja; edycja ustala jej wartość początkową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um script ou animação altera este valor; a edição define onde ele começa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это значение меняет скрипт или анимация; правка задаёт его начальное значение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu değeri bir betik veya animasyon değiştirir; düzenleme başlangıç değerini belirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це значення змінює скрипт або анімація; правка задає його початкове значення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚本或动画会更改此值；编辑设置其起始值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腳本或動畫會更改此值；編輯設定其起始值。"
          }
        }
      }
    },
    "A script writes this text. Its code is edited in the Script editor." : {
      "comment" : "Wallpaper Editor",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتب برنامج نصي هذا النص. يُحرَّر رمزه في محرر البرامج النصية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Skript schreibt diesen Text. Sein Code wird im Skript-Editor bearbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un script escribe este texto. Su código se edita en el editor de scripts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un script écrit ce texte. Son code se modifie dans l’éditeur de scripts."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह टेक्स्ट एक स्क्रिप्ट लिखती है। इसका कोड स्क्रिप्ट एडिटर में संपादित होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno script scrive questo testo. Il suo codice si modifica nell’editor di script."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このテキストはスクリプトが書き込みます。コードはスクリプトエディタで編集します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 텍스트는 스크립트가 작성합니다. 코드는 스크립트 편집기에서 편집합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten tekst pisze skrypt. Jego kod edytuje się w edytorze skryptów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um script escreve este texto. O código é editado no editor de scripts."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот текст пишет скрипт. Его код редактируется в редакторе скриптов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu metni bir betik yazar. Kodu Betik düzenleyicisinde düzenlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей текст пише скрипт. Його код редагується в редакторі скриптів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文本由脚本写入。其代码在脚本编辑器中编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文字由腳本寫入。其程式碼在腳本編輯器中編輯。"
          }
        }
      }
    },
