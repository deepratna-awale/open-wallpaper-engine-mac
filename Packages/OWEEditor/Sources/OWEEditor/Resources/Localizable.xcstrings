    "Every edit made in the editor is dropped. You can undo this." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُتجاهل كل التعديلات التي أُجريت في المحرر. يمكنك التراجع عن ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Änderungen aus dem Editor werden verworfen. Sie können dies widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se descartan todos los cambios hechos en el editor. Puedes deshacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les modifications faites dans l’éditeur sont supprimées. Vous pouvez annuler cette action."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एडिटर में किए गए सभी बदलाव हटा दिए जाते हैं। आप इसे पहले जैसा कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le modifiche fatte nell’editor vengono eliminate. Puoi annullare l’operazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタで行ったすべての編集が破棄されます。この操作は取り消せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집기에서 한 모든 편집 내용이 사라집니다. 실행 취소할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie zmiany wprowadzone w edytorze zostaną odrzucone. Możesz to cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as alterações feitas no editor serão descartadas. Você pode desfazer isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все изменения, сделанные в редакторе, будут отменены. Это действие можно отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenleyicide yapılan tüm düzenlemeler atılır. Bunu geri alabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі зміни, зроблені в редакторі, буде відкинуто. Цю дію можна відмінити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在编辑器中所做的所有编辑都将被丢弃。你可以撤销此操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在編輯器中所做的所有編輯都會被丟棄。你可以還原此操作。"
          }
        }
      }
    },
