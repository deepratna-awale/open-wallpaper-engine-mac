            "state" : "translated",
            "value" : "Ajustar las capas a la escena y entre sí al arrastrar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aimanter les calques à la scène et entre eux pendant le glissement"
          }
