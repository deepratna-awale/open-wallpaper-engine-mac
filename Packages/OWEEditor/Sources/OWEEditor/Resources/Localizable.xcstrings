    "The user property sets “%@” wherever the wallpaper runs. Its current value stays as the fallback." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدد خاصية المستخدم ”%@“ أينما تعمل الخلفية. تبقى القيمة الحالية قيمة احتياطية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Benutzereigenschaft legt „%@“ überall fest, wo das Hintergrundbild läuft. Der aktuelle Wert bleibt als Ersatzwert erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La propiedad de usuario define «%@» allí donde se ejecute el fondo de pantalla. Su valor actual queda como valor de reserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La propriété utilisateur définit « %@ » partout où le fond d’écran s’exécute. Sa valeur actuelle reste la valeur de repli."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जहाँ भी वॉलपेपर चलता है, यूज़र प्रॉपर्टी “%@” सेट करती है। मौजूदा वैल्यू फ़ॉलबैक के रूप में रहती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La proprietà utente imposta “%@” ovunque venga eseguito lo sfondo. Il valore attuale resta come riserva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙が実行される場所ではどこでも、ユーザプロパティが「%@」を設定します。現在の値は代替値として残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면이 실행되는 모든 곳에서 사용자 속성이 ‘%@’을(를) 설정합니다. 현재 값은 대체 값으로 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Właściwość użytkownika ustawia „%@” wszędzie, gdzie działa tapeta. Bieżąca wartość pozostaje wartością zapasową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A propriedade do usuário define “%@” onde quer que a imagem de fundo seja executada. O valor atual fica como reserva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользовательское свойство задаёт «%@» везде, где работают обои. Текущее значение остаётся запасным."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcı özelliği, duvar kâğıdının çalıştığı her yerde “%@” değerini belirler. Geçerli değer yedek olarak kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Властивість користувача задає «%@» скрізь, де працює шпалера. Поточне значення лишається запасним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论墙纸在哪里运行，都由用户属性设定“%@”。当前值保留为后备值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無論背景圖片在哪裡執行，都由使用者屬性設定「%@」。目前的值會保留為備用值。"
          }
        }
      }
    },
