    "A copy of the wallpaper with your edits is added to the library. The original stays as it is." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُضاف نسخة من الخلفية مع تعديلاتك إلى المكتبة، ويبقى الأصل كما هو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kopie des Hintergrundbilds mit Ihren Änderungen wird zur Mediathek hinzugefügt. Das Original bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añade a la biblioteca una copia del fondo de pantalla con tus cambios. El original no se modifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une copie du fond d’écran avec vos modifications est ajoutée à la bibliothèque. L’original reste tel quel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके बदलावों वाली वॉलपेपर की एक कॉपी लाइब्रेरी में जोड़ी जाती है। मूल वैसा ही रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia dello sfondo con le tue modifiche viene aggiunta alla libreria. L’originale resta invariato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集を反映した壁紙のコピーがライブラリに追加されます。元の壁紙はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집 내용이 적용된 배경화면 사본이 라이브러리에 추가됩니다. 원본은 그대로 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia tapety z Twoimi zmianami zostanie dodana do biblioteki. Oryginał pozostanie bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma cópia da imagem de fundo com suas alterações é adicionada à biblioteca. O original continua como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия обоев с вашими изменениями добавляется в библиотеку. Оригинал остаётся без изменений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenlemelerinizi içeren duvar kâğıdının bir kopyası kütüphaneye eklenir. Orijinali olduğu gibi kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копію шпалери з вашими змінами буде додано до бібліотеки. Оригінал залишиться без змін."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带有你所做编辑的墙纸副本会添加到资料库。原墙纸保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含有你所做編輯的背景圖片拷貝會加入資料庫。原始背景圖片保持不變。"
          }
        }
      }
    },
    "A label can be a localisation key. Conditions and bindings compare the value." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن تكون التسمية مفتاح ترجمة. تقارن الشروط والروابط القيمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Label kann ein Lokalisierungsschlüssel sein. Bedingungen und Verknüpfungen vergleichen den Wert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una etiqueta puede ser una clave de localización. Las condiciones y los vínculos comparan el valor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un libellé peut être une clé de localisation. Les conditions et les liaisons comparent la valeur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेबल एक लोकलाइज़ेशन की हो सकता है। कंडीशन और बाइंडिंग वैल्यू की तुलना करती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’etichetta può essere una chiave di localizzazione. Le condizioni e i collegamenti confrontano il valore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ラベルにはローカライズキーも使えます。条件とバインドは値を比較します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이블은 현지화 키일 수도 있습니다. 조건과 연결은 값을 비교합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etykieta może być kluczem lokalizacji. Warunki i powiązania porównują wartość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um rótulo pode ser uma chave de localização. Condições e vínculos comparam o valor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпись может быть ключом локализации. Условия и привязки сравнивают значение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiket bir yerelleştirme anahtarı olabilir. Koşullar ve bağlamalar değeri karşılaştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підпис може бути ключем локалізації. Умови та привʼязки порівнюють значення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签可以是本地化键。条件和绑定比较的是值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤可以是在地化鍵值。條件和綁定比較的是值。"
          }
        }
      }
    },
    "A script and the user property “%@” set this field" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد هذا الحقل برنامج نصي وخاصية المستخدم ”%@“"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Skript und die Benutzereigenschaft „%@“ legen dieses Feld fest"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un script y la propiedad de usuario «%@» definen este campo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un script et la propriété utilisateur « %@ » définissent ce champ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक स्क्रिप्ट और यूज़र प्रॉपर्टी “%@” यह फ़ील्ड सेट करते हैं"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno script e la proprietà utente “%@” impostano questo campo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリプトとユーザプロパティ「%@」がこのフィールドを設定します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크립트와 사용자 속성 ‘%@’이(가) 이 필드를 설정합니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To pole ustawiają skrypt i właściwość użytkownika „%@”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um script e a propriedade do usuário “%@” definem este campo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это поле задают скрипт и пользовательское свойство «%@»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu alanı bir betik ve “%@” kullanıcı özelliği belirler"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це поле задають скрипт і властивість користувача «%@»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚本和用户属性“%@”设定此字段"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腳本和使用者屬性「%@」設定此欄位"
          }
        }
      }
    },
    "A script or animation changes this value; the edit sets where it starts." : {
      "comment" : "Wallpaper Editor",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغيّر برنامج نصي أو رسم متحرك هذه القيمة؛ يحدد التعديل نقطة بدايتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Skript oder eine Animation ändert diesen Wert; die Änderung legt seinen Startwert fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un script o una animación cambia este valor; la edición define dónde empieza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un script ou une animation modifie cette valeur ; la modification définit sa valeur de départ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
