    "The depth comes from one frame of the scene." : {
      "comment" : "Depth map section of the Scene Editor and the Wallpaper Editor",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستمد العمق من إطار واحد من المشهد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tiefe stammt aus einem einzelnen Frame der Szene."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profundidad se obtiene de un solo fotograma de la escena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profondeur provient d’une seule image de la scène."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेप्थ सीन के एक फ़्रेम से ली जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
