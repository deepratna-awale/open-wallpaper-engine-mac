          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el mapa de profundidad: el blanco está cerca y el negro, lejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la carte de profondeur : le blanc est proche, le noir est loin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
