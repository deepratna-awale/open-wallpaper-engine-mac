{
  "sourceLanguage" : "en",
  "strings" : {
    "A depth map is already being generated." : {
      "comment" : "Depth map section of the Scene Editor and the Wallpaper Editor",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجري إنشاء خريطة عمق بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird bereits eine Tiefenkarte erzeugt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya se está generando un mapa de profundidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une carte de profondeur est déjà en cours de génération."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक डेप्थ मैप पहले से बन रहा है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È già in corso la generazione di una mappa di profondità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに深度マップを生成中です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 깊이 맵을 생성하는 중입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa głębi jest już generowana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um mapa de profundidade já está sendo gerado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта глубины уже создаётся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaten bir derinlik haritası oluşturuluyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта глибини вже створюється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在生成深度图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在產生深度圖。"
          }
        }
      }
    },
    "Adds Wallpaper Engine’s Depth Parallax effect, bound to this depth map." : {
      "comment" : "Depth map section of the Scene Editor and the Wallpaper Editor",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف تأثير اختلاف منظر العمق من Wallpaper Engine مرتبطًا بخريطة العمق هذه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt den Tiefenparallaxe-Effekt von Wallpaper Engine hinzu, verknüpft mit dieser Tiefenkarte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el efecto Paralaje de profundidad de Wallpaper Engine, vinculado a este mapa de profundidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute l’effet Parallaxe de profondeur de Wallpaper Engine, lié à cette carte de profondeur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine का डेप्थ पैरालैक्स इफ़ेक्ट जोड़ता है, जो इस डेप्थ मैप से जुड़ा होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge l’effetto Parallasse di profondità di Wallpaper Engine, collegato a questa mappa di profondità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この深度マップに結び付けた Wallpaper Engine の深度視差エフェクトを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 깊이 맵에 연결된 Wallpaper Engine의 깊이 시차 효과를 추가합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje efekt Paralaksa głębi z Wallpaper Engine powiązany z tą mapą głębi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona o efeito Paralaxe de Profundidade do Wallpaper Engine, vinculado a este mapa de profundidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет эффект «Параллакс глубины» из Wallpaper Engine, связанный с этой картой глубины."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu derinlik haritasına bağlı Wallpaper Engine Derinlik Paralaksı efektini ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає ефект «Паралакс глибини» з Wallpaper Engine, пов’язаний із цією картою глибини."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 Wallpaper Engine 的“深度视差”效果，并绑定到此深度图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入 Wallpaper Engine 的「深度視差」效果，並連結至此深度圖。"
          }
        }
      }
    },
